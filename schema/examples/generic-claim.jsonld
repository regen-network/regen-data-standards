  "@type": "GenericClaim",
  "name": "Hedgerow planting on plot A, spring 2026",
  "claimStatement": "Hedgerow Cooperative planted 400 m of mixed native hedgerow along the northern boundary of plot A between 1 March and 15 April 2026.",
  "inLanguage": "en",
  "assertedBy": [
    {
      "@type": "Entity",
      "name": "Hedgerow Cooperative",
      "type": "COMMUNITY"
    }
  ],
  "assertedAt": "2026-05-02T07:30:00+00:00",
  "hasSubject": {
    "@type": "ClaimSubject",
    "id": "https://example.org/plot/A",
    "name": "Plot A"
  },
  "hasEvidence": [
    "https://example.org/evidence/planting-log-2026-v1.pdf"
  ],
  "hasEvidenceCitation": [
    {
      "@type": "EvidenceCitation",
      "source": "https://example.org/evidence/planting-log-2026-v1.pdf",
      "selector": [

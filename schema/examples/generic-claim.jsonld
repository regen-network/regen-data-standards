    "@vocab": "https://framework.regen.network/schema/",
    "assertedAt": {
      "@type": "xsd:dateTime",
      "@id": "assertedAt"
    },
    "id": "@id",
    "description": {
      "@id": "schema:description"
    },
    "type": {
      "@id": "type",
      "@type": "@vocab",
      "@context": {
        "INDIVIDUAL": "rfs:Individual",
        "ORGANIZATION": "rfs:Organization",
        "COMMUNITY": "rfs:Community"
      }
    },
    "walletAddress": {
      "@id": "walletAddress"
    },
    "hasClaimant": {
      "@type": "@id",
      "@id": "hasClaimant"
    },
    "hasClaimType": {
      "@id": "hasClaimType",
      "@type": "@vocab",
      "@context": {
        "ECOLOGICAL": "rft:Ecological",
        "SOCIAL": "rft:Social",
        "FINANCIAL": "rft:Financial",
        "GOVERNANCE": "rft:Governance",
        "BIOCULTURAL": "rft:Biocultural"
      }
    },
    "hasEvidence": {
      "@type": "@id",
      "@id": "hasEvidence"
    },
    "hasSubject": {
      "@type": "@id",
      "@id": "hasSubject"
    },
    "identifier": {
      "@id": "schema:identifier"
    },
    "image": {
      "@id": "schema:image"
    },
    "name": {
      "@id": "schema:name"
    },
    "references": {
      "@type": "@id",
      "@id": "dcterms:references"
    },
    "url": {
      "@type": "@id",
      "@id": "schema:url"
    },
    "version": {
      "@id": "schema:version"
    },
    "wasAssociatedWith": {
      "@type": "@id",
      "@id": "prov:wasAssociatedWith"
    },
    "wasAttributedTo": {
      "@type": "@id",
      "@id": "prov:wasAttributedTo"
    },
    "wasRevisionOf": {
      "@type": "@id",
      "@id": "prov:wasRevisionOf"
    },
    "Claim": {
      "@id": "Claim"
    },
    "ClaimSubject": {
      "@id": "ClaimSubject"
    },
    "Entity": {
      "@id": "Entity"
    },
    "Evidence": {
      "@id": "Evidence"
    },
    "Link": {
      "@id": "Link"
    },
    "ProvActivity": {
      "@id": "prov:Activity"
    },
    "ProvAgent": {
      "@id": "prov:Agent"
    },
    "ProvEntity": {
      "@id": "prov:Entity"
    },
    "VersionedLink": {
      "@id": "VersionedLink"
    }
  },
  "@type": "Claim",
  "name": "Hedgerow planting on plot A, spring 2026",
  "description": "Hedgerow Cooperative planted 400 m of mixed native hedgerow along the northern boundary of plot A between 1 March and 15 April 2026.",
  "hasClaimType": "ECOLOGICAL",
  "hasClaimant": [
    {
      "@type": "Entity",
      "name": "Hedgerow Cooperative",
      "type": "COMMUNITY"
    }
  ],
  "assertedAt": "2026-05-02T07:30:00Z",
  "hasSubject": {
    "@type": "ClaimSubject",
    "id": "https://example.org/plot/A",
    "name": "Plot A"
  },
  "hasEvidence": [
    {
      "@type": "Evidence",
      "id": "https://example.org/evidence/planting-log-2026-v1.pdf#page=2",
      "name": "Planting log, spring 2026 (v1)"
    }
  ]

  "@type": "Attestation",
  "name": "Steward review of the plot A hedgerow planting",
  "description": "The planted hedgerow along the northern boundary of plot A is present along its full length, as the planting log states.",
  "hasClaimant": [
    {
      "@type": "Entity",
      "name": "Valley Stewards Circle",
      "type": "COMMUNITY"
    }
  ],
  "assertedAt": "2026-06-10T09:00:00Z",
  "hasSubject": {
    "@type": "ClaimSubject",
    "id": "https://example.org/plot/A",
    "name": "Plot A"
  },
  "hasTarget": [
    "https://example.org/placeholder/claim-iri/generic-claim-v1"
  ],
  "outcome": "https://example.org/vocab/review/confirmed",
  "rationale": "The steward walked the boundary and compared it with the planting log.",
  "verificationMethod": "OTHER",
  "verificationMethodDescriptor": "On-site walkover by a community steward",
  "hasEvidence": [
    {
      "@type": "Evidence",
      "id": "https://example.org/evidence/walkover-photos-2026-06.zip",
      "name": "Walkover photographs, June 2026",
      "sourceType": "STILL_IMAGE",
      "mediaType": "application/zip",
      "contentHash": {
        "@type": "ContentDigest",
        "algorithm": "SHA_256",
        "digestValue": "7ad54936431d88ca8a38d4b1f1423725bba6c921ef303f822e1c80df8157b7f5"
      },
      "resolver": [
        "https://example.org/evidence/walkover-photos-2026-06.zip"
      ]
    }
  ]

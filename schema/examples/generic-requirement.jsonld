  "@type": "GenericRequirement",
  "identifier": "EXAMPLE-REGISTRATION-CP-1",
  "requirementStatement": "A site's crediting term is ten years, with an option to renew. Each renewal period is ten years, with no limit on the number of renewals.",
  "requirementSource": {
    "@type": "EvidenceCitation",
    "source": "regen:113UTi1u87QLrE9cxVua6RvK9Jcku8qtr7dAD2A4VQwpiP8X2mkV.pdf",
    "selector": [
      {
        "@type": "FragmentSelector",
        "value": "page=7",
        "conformsTo": "http://tools.ietf.org/rfc/rfc3778"
      }
    ]
  },
  "assessmentScope": "Checks only the length of the crediting period a C06SiteClaim states, with both dates inclusive. It does not check that the cited plan states those dates, that the plan is authentic, or that a renewal was approved.",
  "acceptsEvidence": [
    {
      "@type": "EvidenceKind",
      "sourceType": "TEXT",
      "mediaType": "application/pdf"
    }
  ],
  "requirementCheck": {
    "@type": "RequirementCheck",
    "queryLanguage": "rfs:Sparql11Sep0002",
    "evidenceAvailableQuery": "PREFIX rfs: <https://framework.regen.network/schema/>\nPREFIX schema: <http://schema.org/>\nPREFIX oa: <http://www.w3.org/ns/oa#>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nASK {\n  GRAPH ?_claim_iri {\n    ?_claim_iri a rfs:C06SiteClaim ; rfs:creditingPeriod ?period ;\n      rfs:hasEvidenceCitation/oa:hasSource ?source .\n    ?period schema:startDate ?start ; schema:endDate ?end .\n    FILTER(isIRI(?source))\n    FILTER(datatype(?start) = xsd:date && datatype(?end) = xsd:date)\n  }\n}",
    "needsHumanReviewQuery": "PREFIX rfs: <https://framework.regen.network/schema/>\nPREFIX schema: <http://schema.org/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nASK {\n  GRAPH ?_claim_iri {\n    ?_claim_iri rfs:creditingPeriod ?period .\n    ?period schema:startDate ?start ; schema:endDate ?end .\n  }\n  FILTER(?end >= (?start + \"P20Y\"^^xsd:yearMonthDuration - \"P1D\"^^xsd:dayTimeDuration))\n}",
    "satisfiedQuery": "PREFIX rfs: <https://framework.regen.network/schema/>\nPREFIX schema: <http://schema.org/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nASK {\n  GRAPH ?_claim_iri {\n    ?_claim_iri rfs:creditingPeriod ?period .\n    ?period schema:startDate ?start ; schema:endDate ?end .\n  }\n  FILTER(?end = (?start + \"P10Y\"^^xsd:yearMonthDuration - \"P1D\"^^xsd:dayTimeDuration))\n}",
    "missingEvidenceExplanation": "The claim states no complete crediting period with typed dates, or cites no source.",
    "needsHumanReviewExplanation": "The stated period is at least twenty years, so it may include ten-year renewal periods; a reviewer must check that a renewal decision covers them.",
    "satisfiedExplanation": "The claim states a ten-year crediting period. This does not establish that the cited plan states it.",
    "unmetExplanation": "The stated period is not ten years, and too short to include a ten-year renewal period."
  }
}

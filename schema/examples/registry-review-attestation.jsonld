  "@type": "RegistryReviewAttestation",
  "name": "Registry confirmation of the cohort-based crediting structure",
  "description": "The registry accepts the rolling cohort-based crediting and permanence structure described in the project plan for the cohorts enrolled from 2020 to 2023, subject to the scope below.",
  "hasClaimant": [
    {
      "@type": "Entity",
      "name": "Example Registry",
      "type": "ORGANIZATION"
    }
  ],
  "assertedAt": "2026-03-12T00:00:00Z",
  "hasSubject": {
    "@type": "ClaimSubject",
    "id": "https://example.org/c06/project/P-001",
    "name": "Example project P-001"
  },
  "hasTarget": [
    "https://example.org/placeholder/claim-iri/verifier-finding-7-1",
    "https://example.org/placeholder/claim-iri/verifier-finding-7-2"
  ],
  "reliesOn": [
    "https://example.org/placeholder/claim-iri/developer-enrolment-cutoff"
  ],
  "appliesRuleSet": [
    "https://example.org/rule-set/credit-class-c06/1.5.2"
  ],
  "outcome": "rfs:ApprovedForRegistration",
  "rationale": "Each cohort keeps a full ten-year crediting period from its baseline sampling, and the enrolment cutoff prevents open-ended expansion.",
  "verificationMethod": "THIRD_PARTY_AUDITED",
  "scope": {
    "@type": "Scope",
    "appliesTo": [
      "https://example.org/c06/cohort/P-001-2020",
      "https://example.org/c06/cohort/P-001-2021",
      "https://example.org/c06/cohort/P-001-2022",
      "https://example.org/c06/cohort/P-001-2023"
    ],
    "exclusion": [
      "Open-ended addition of plots, farms or project areas after the enrolment cutoff."
    ],
    "limitation": "Confirms the acceptability of the project structure; does not replace the verifier's responsibility to validate the supporting evidence."
  },
  "issuerRole": "REGISTRY_AGENT",
  "conditions": [
    {
      "@type": "Condition",
      "conditionLabel": "C-1",
      "description": "Each farm, cohort and project area remains individually identifiable and traceable.",
      "milestone": "VERIFICATION"
    }
  ],
  "hasEvidence": [
    {
      "@type": "Evidence",
      "id": "https://example.org/registry/confirmation-2026-03-12.pdf",
      "name": "Registry confirmation letter, 12 March 2026",
      "sourceType": "TEXT",
      "mediaType": "application/pdf",
      "contentHash": {
        "@type": "ContentDigest",
        "algorithm": "SHA_256",
        "digestValue": "06379123b857f6899002024e6a1d89eced2583a5ee1d09b8f3952f21e9bdc31f"
      },
      "resolver": [
        "https://example.org/registry/confirmation-2026-03-12.pdf"
      ]
    }
  ]

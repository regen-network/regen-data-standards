  "@type": "EvidenceSupportEvaluation",
  "name": "Steward assessment of the plot A hedgerow evidence",
  "claimStatement": "The planting log and the June walkover photographs support the claim that 400 m of hedgerow was planted on plot A, but are not enough to establish it: the photographs cover about 250 m of the boundary.",
  "assertedBy": [
    {
      "@type": "Community",
      "name": "Valley Stewards Circle"
    }
  ],
  "assertedAt": "2026-06-12T10:00:00+00:00",
  "hasSubject": {
    "@type": "ClaimSubject",
    "id": "https://example.org/plot/A"
  },
  "hasTarget": [
    "regen:1132H6LB5eo2x9ivXEryW2DBpgZ6qqZCtRmSC9PwvJREKbhdhXKG.pdf",
    "regen:113FyhiPnebgnQywYeA4JAsgbzmfK38BVzQo8A4KK1nj3DX6wcXT.raw"
  ],
  "assessedAgainst": "https://example.org/placeholder/claim-iri/generic-claim-v1",
  "hasResult": {
    "@type": "EvidenceSupportResult",
    "outcome": "SUPPORTS",
    "evidenceSufficiency": "INSUFFICIENT"
  },
  "rationale": "The log records 400 m planted; the photographs show the western 250 m of the boundary only.",
  "evaluationMethod": [
    "rfs:DocumentReview"
  ],
  "evaluationMethodDescription": "Desk review of the cited evidence by a community steward"
}

@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rfs: <https://framework.regen.network/schema/> .
@prefix rft: <https://framework.regen.network/taxonomy/> .
@prefix schema1: <http://schema.org/> .
@prefix sdgs: <https://sdgs.un.org/goals/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

prov:Activity a sh:NodeShape ;
    rdfs:comment "PROV-O Activity: something that occurs over a period of time, such as the domain activity a specialized claim describes (a planting, a restoration) or the activity that produced a piece of evidence (a survey, a lab analysis)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass prov:Activity .

prov:Agent a sh:NodeShape ;
    rdfs:comment "PROV-O Agent: something that bears responsibility, such as a person, organization or community." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass prov:Agent .

prov:Entity a sh:NodeShape ;
    rdfs:comment "PROV-O Entity: a thing with some fixed aspects, such as a Claim version." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass prov:Entity .

rfs:Attestation a sh:NodeShape ;
    rdfs:comment "An issuer's judgment, made at a stated time, about what it targets: exact versions of claims, of other attestations, or a snapshot of claims. As a Claim it is attributed (hasClaimant names the issuer), immutable and revisable with wasRevisionOf; it is about a subject, such as a project or a plot, even when it judges a claim about that subject. It does not carry its own hash or IRI, anchoring state, or a status that changes after it is made: a later judgment is a new Attestation." ;
    sh:closed true ;
    sh:ignoredProperties ( rfs:issuerRole rfs:findingLabel rfs:findingType rdf:type rfs:conditions ) ;
    sh:property [ sh:description "What an attestation judges or answers: the identifier of an exact, immutable version of a claim, of another attestation, or of a snapshot (a fixed set of claim versions). Never a logical identifier or label. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rfs:hasTarget ],
        [ sh:datatype xsd:boolean ;
            sh:description "True when the issuer explicitly gives the judgment no limits beyond what it targets (story map AD-1), so that an unlimited approval is a stated choice rather than an omission. An attestation that states it has no scope." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path rfs:unbounded ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion as the claimant states it in natural language. This is asserted content, not a presentational summary: changing it changes the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:description ],
        [ sh:description "Identifier of a requirement within one version of a rule set or checklist, for example a credit class registration requirement. The identifier must name the checklist version as well as the requirement, because the same short ID can name different requirements in different versions. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rfs:requirement ],
        [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path schema1:url ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises, typically its ClaimIRI. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its attestations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path prov:wasRevisionOf ],
        [ sh:description "Exact versions of claims or attestations that a judgment depends on without judging them, for example the claim stating an enrolment cutoff that an approval relies on. Each value is the identifier of one immutable version. Specializes dcterms:references, so it asserts neither derivation nor support. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rfs:reliesOn ],
        [ sh:datatype xsd:string ;
            sh:description "Why the issuer reached the outcome." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rfs:rationale ],
        [ sh:description "The verdict, as a term from the vocabulary of the program or rule set the judgment is made under, for example a registration determination." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path rfs:outcome ],
        [ sh:description "Identifier of an exact version of a normative rule set applied, such as a credit class, a methodology or a program guide version. It is content and enters the identity of the record. It is distinct from a schema-version declaration, which states which schema the RDF conforms to. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rfs:appliesRuleSet ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of a verification method that the VerificationMethodType enumeration does not cover; required when verificationMethod is OTHER. It is the extension path: a method that recurs is added to the enumeration in a later schema version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path rfs:verificationMethodDescriptor ],
        [ sh:class rfs:ClaimSubject ;
            sh:description "What the judgment is about: a project, plot or other subject. It is stated even when it is also the subject of a targeted claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path rfs:hasSubject ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the issuer relied on." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path rfs:hasEvidence ],
        [ sh:class rfs:Entity ;
            sh:description "The issuer: the party that makes the judgment and takes responsibility for it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path rfs:hasClaimant ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the issuer made the judgment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" ],
        [ sh:class rfs:Scope ;
            sh:description "Where the judgment applies: the subjects it covers, what it explicitly excludes, and what it does not establish." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:scope ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable title of the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema1:name ],
        [ sh:description "How the assertion or judgment was established, as structured data, so that a consumer can distinguish, for example, a lab-measured value from a self-attested one. One method per record: its party and date are those of the record that carries it (for an attestation, its issuer and assertedAt), so a subject checked by two methods has two records, each with its own party and date. A value of OTHER must come with verificationMethodDescriptor." ;
            sh:in ( rfs:SelfAttested rfs:PeerOrCommunity rfs:LabMeasured rfs:SensorDerived rfs:ModelEstimated rfs:ThirdPartyAudited rfs:OtherVerificationMethod ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path rfs:verificationMethod ] ;
    sh:targetClass rfs:Attestation .

rfs:BT01ProjectInfo a sh:NodeShape ;
    rdfs:label "BT01 Project Info" ;
    rdfs:comment "Project info for Tebu projects." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:description ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for monitoring the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 29 ;
            sh:path rfs:hasProjectMonitor ],
        [ sh:class rfs:Entity ;
            sh:description "The organization that is a partner for the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 32 ;
            sh:path rfs:hasProjectPartner ],
        [ sh:description "The types of activities being implemented in projects" ;
            sh:in ( rft:ResidueTillageManagement rft:BiocharProduction rft:ImprovedForestManagement rft:Agroforestry rft:PrescribedGrazing rft:RiparianForestBuffers rft:SoilAmendments rft:Conservation rft:Ecotourism rft:CoverCropping rft:TreePlanting rft:PhotocatalystApplication rft:EcosystemRestoration rft:IndustrialBiocharProduction rft:ArtisanalBiocharProduction rft:Biochar rft:EnhancedRockWeathering rft:CompostAmendments rft:KeystoneSpeciesConservation rft:UmbrellaSpeciesConservation rft:Silvopasture rft:ForestFarming rft:NonUrbanForestImprovement rft:UrbanForestImprovement rft:Afforestation rft:Reforestation ) ;
            sh:order 25 ;
            sh:path rfs:activity ],
        [ sh:datatype xsd:duration ;
            sh:description "The duration of the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path rfs:projectDuration ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:float ;
            sh:description "The ecological connectivity index of the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:ecologicalConnectivityIndex ],
        [ sh:description "The type of market for the associated credits." ;
            sh:in ( rfs:ComplianceMarket rfs:VoluntaryMarket ) ;
            sh:order 9 ;
            sh:path rfs:marketType ],
        [ sh:description "The conservation status of the project." ;
            sh:in ( rfs:IucnExtinct rfs:IucnExtinctInWild rfs:IucnCriticallyEndangered rfs:IucnEndangered rfs:IucnVulnerable rfs:IucnNearThreatened rfs:IucnLeastConcern rfs:IucnDataDeficient rfs:IucnNotEvaluated ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path rfs:iucnConservationStatus ],
        [ sh:datatype xsd:string ;
            sh:description "The version of the credit class used for the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path rfs:creditClassVersion ],
        [ sh:description "The administrative area associated with the project." ;
            sh:in ( "ANTIOQUIA" "CUNDINAMARCA" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path rfs:hasAdministrativeArea ],
        [ sh:class rfs:ReferenceId ;
            sh:description "External reference IDs associated with the project." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path rfs:hasReferenceId ],
        [ sh:description "The environment type of the project." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:order 19 ;
            sh:path rfs:environmentType ],
        [ sh:class rfs:ManagementArea ;
            sh:description "The management areas associated with the project." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path rfs:hasManagementAreas ],
        [ sh:class rfs:Impact ;
            sh:description "Co-benefits are any secondary impacts that may result from adhering to the protocol and/or management practices associated with the credit class. They can be qualitative or quantitative." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 27 ;
            sh:path rfs:hasCoBenefits ],
        [ sh:class rfs:Entity ;
            sh:description "The environmental authority associated with the project." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path rfs:hasEnvironmentalAuthority ],
        [ sh:class rfs:Entity ;
            sh:description "The organization that owns the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 31 ;
            sh:path rfs:hasProjectOwner ],
        [ sh:class rfs:Link ;
            sh:description "A list of links associated with the project." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path rfs:hasLinks ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema1:name ],
        [ sh:description "The region associated with the project." ;
            sh:in ( "ANDEAN" "CARIBBEAN" "ORINOCO" "PACIFIC" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 20 ;
            sh:path rfs:region ],
        [ sh:description "The sub-watershed associated with the project." ;
            sh:in ( "RIO_FRIO_Y_OTROS_DIRECTOS_AL_CAUCA" "RIO_SUMAPAZ" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 24 ;
            sh:path rfs:subWatershed ],
        [ sh:datatype xsd:string ;
            sh:description "The start date of the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path schema1:startDate ],
        [ sh:description "The type of biome associated with the project." ;
            sh:in ( "ANDEAN_OROBIOME_NORTH_PACIFIC_FOOTHILLS" "LARGE_TOLIMA_HYDROBIOME" "LARGE_TOLIMA_SUBANDEAN_OROBIOME" "TROPICAL_HUMID_ZONOBIOME_TOLIMA_GRANDE" ) ;
            sh:minCount 1 ;
            sh:order 22 ;
            sh:path rfs:biomeType ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for owning the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path rfs:hasProjectVerifier ],
        [ sh:description "The watershed associated with the project." ;
            sh:in ( "FRIO_RIVER" "SUMAPAZ_RIVER_LOWER_WATERSHED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 23 ;
            sh:path rfs:watershed ],
        [ sh:description "The bioregion associated with the project." ;
            sh:in ( "LOW_MONTANE_VERY_HUMID_FOREST" "ORINOCO_SAVANNA" "PREMONTANE_HUMID_FOREST" "RIPARIAN_FOREST" "SAVANNA" "TROPICAL_HUMID_FOREST" "TROPICAL_DRY_FOREST" ) ;
            sh:minCount 1 ;
            sh:order 21 ;
            sh:path rfs:bioregion ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for operating the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 30 ;
            sh:path rfs:hasProjectOperator ],
        [ sh:class qudt:QuantityValue ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path rfs:projectSize ],
        [ sh:datatype xsd:string ;
            sh:description "The end date of the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path schema1:endDate ],
        [ sh:class rfs:Methodology ;
            sh:description "The methodology that the project uses." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 33 ;
            sh:path rfs:usesMethodology ],
        [ sh:class rfs:Impact ;
            sh:description "The primary impact expected from adhering to the protocol and/or management practices associated with the credit class. Generally speaking the quantifiable components of this impact are associated with the credit type that the credit class exists under (e.g. Carbon, Biodiversity, etc)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path rfs:hasPrimaryImpact ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for owning the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 28 ;
            sh:path rfs:hasProjectDeveloper ],
        [ sh:description "The social cultural index of the project." ;
            sh:in ( "VERY_HIGH" "HIGH" "MEDIUM" "LOW" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path rfs:socialCulturalIndex ],
        [ sh:class geo:Feature ;
            sh:description "The location of the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path rfs:hasFeature ] ;
    sh:targetClass rfs:BT01ProjectInfo .

rfs:C01ProjectInfo a sh:NodeShape ;
    rdfs:label "C01 Project Info" ;
    rdfs:comment "Project info for Verra Verified Carbon Standard projects." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The type of market for the associated credits." ;
            sh:in ( rfs:ComplianceMarket rfs:VoluntaryMarket ) ;
            sh:order 2 ;
            sh:path rfs:marketType ],
        [ sh:description "The environment type of the project." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:order 12 ;
            sh:path rfs:environmentType ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "The type of biome associated with the project." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path rfs:biomeType ],
        [ sh:description "The types of activities being implemented in projects" ;
            sh:in ( rft:ResidueTillageManagement rft:BiocharProduction rft:ImprovedForestManagement rft:Agroforestry rft:PrescribedGrazing rft:RiparianForestBuffers rft:SoilAmendments rft:Conservation rft:Ecotourism rft:CoverCropping rft:TreePlanting rft:PhotocatalystApplication rft:EcosystemRestoration rft:IndustrialBiocharProduction rft:ArtisanalBiocharProduction rft:Biochar rft:EnhancedRockWeathering rft:CompostAmendments rft:KeystoneSpeciesConservation rft:UmbrellaSpeciesConservation rft:Silvopasture rft:ForestFarming rft:NonUrbanForestImprovement rft:UrbanForestImprovement rft:Afforestation rft:Reforestation ) ;
            sh:order 18 ;
            sh:path rfs:activity ],
        [ sh:datatype xsd:string ;
            sh:description "The version of the credit class used for the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:creditClassVersion ],
        [ sh:class rfs:Entity ;
            sh:description "The organization that is a partner for the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path rfs:hasProjectPartner ],
        [ sh:datatype xsd:string ;
            sh:description "The bioregion associated with the project." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rfs:bioregion ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for monitoring the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path rfs:hasProjectMonitor ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "The region associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path rfs:region ],
        [ sh:datatype xsd:string ;
            sh:description "The watershed associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path rfs:watershed ],
        [ sh:datatype xsd:string ;
            sh:description "The sub-watershed associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path rfs:subWatershed ],
        [ sh:class qudt:QuantityValue ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path rfs:projectSize ],
        [ sh:datatype xsd:string ;
            sh:description "The start date of the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:startDate ],
        [ sh:class rfs:ReferenceId ;
            sh:description "External reference IDs associated with the project." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path rfs:hasReferenceId ],
        [ sh:class rfs:Entity ;
            sh:description "The organization that owns the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path rfs:hasProjectOwner ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for owning the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path rfs:hasProjectVerifier ],
        [ sh:class rfs:Impact ;
            sh:description "Co-benefits are any secondary impacts that may result from adhering to the protocol and/or management practices associated with the credit class. They can be qualitative or quantitative." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path rfs:hasCoBenefits ],
        [ sh:datatype xsd:string ;
            sh:description "The end date of the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:endDate ],
        [ sh:class geo:Feature ;
            sh:description "The location of the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path rfs:hasFeature ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for operating the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path rfs:hasProjectOperator ],
        [ sh:class rfs:Link ;
            sh:description "A list of links associated with the project." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:hasLinks ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:name ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for owning the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path rfs:hasProjectDeveloper ],
        [ sh:class rfs:Impact ;
            sh:description "The primary impact expected from adhering to the protocol and/or management practices associated with the credit class. Generally speaking the quantifiable components of this impact are associated with the credit type that the credit class exists under (e.g. Carbon, Biodiversity, etc)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path rfs:hasPrimaryImpact ],
        [ sh:class rfs:Methodology ;
            sh:description "The methodology that the project uses." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path rfs:usesMethodology ] ;
    sh:targetClass rfs:C01ProjectInfo .

rfs:C02ProjectInfo a sh:NodeShape ;
    rdfs:label "C02 Project Info" ;
    rdfs:comment "Project info for City Forest Carbon Credit projects." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The type of market for the associated credits." ;
            sh:in ( rfs:ComplianceMarket rfs:VoluntaryMarket ) ;
            sh:order 2 ;
            sh:path rfs:marketType ],
        [ sh:description "The environment type of the project." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:order 12 ;
            sh:path rfs:environmentType ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "The type of biome associated with the project." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path rfs:biomeType ],
        [ sh:datatype xsd:string ;
            sh:description "The version of the credit class used for the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:creditClassVersion ],
        [ sh:class rfs:Entity ;
            sh:description "The organization that is a partner for the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path rfs:hasProjectPartner ],
        [ sh:datatype xsd:string ;
            sh:description "The bioregion associated with the project." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rfs:bioregion ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for monitoring the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path rfs:hasProjectMonitor ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path schema1:url ],
        [ sh:description "The types of activities being implemented in projects" ;
            sh:in ( rft:ResidueTillageManagement rft:BiocharProduction rft:ImprovedForestManagement rft:Agroforestry rft:PrescribedGrazing rft:RiparianForestBuffers rft:SoilAmendments rft:Conservation rft:Ecotourism rft:CoverCropping rft:TreePlanting rft:PhotocatalystApplication rft:EcosystemRestoration rft:IndustrialBiocharProduction rft:ArtisanalBiocharProduction rft:Biochar rft:EnhancedRockWeathering rft:CompostAmendments rft:KeystoneSpeciesConservation rft:UmbrellaSpeciesConservation rft:Silvopasture rft:ForestFarming rft:NonUrbanForestImprovement rft:UrbanForestImprovement rft:Afforestation rft:Reforestation ) ;
            sh:order 18 ;
            sh:path rfs:activity ],
        [ sh:datatype xsd:string ;
            sh:description "The region associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path rfs:region ],
        [ sh:datatype xsd:string ;
            sh:description "The watershed associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path rfs:watershed ],
        [ sh:datatype xsd:string ;
            sh:description "The sub-watershed associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path rfs:subWatershed ],
        [ sh:class qudt:QuantityValue ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path rfs:projectSize ],
        [ sh:datatype xsd:string ;
            sh:description "The start date of the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:startDate ],
        [ sh:class rfs:ReferenceId ;
            sh:description "External reference IDs associated with the project." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path rfs:hasReferenceId ],
        [ sh:class rfs:Entity ;
            sh:description "The organization that owns the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path rfs:hasProjectOwner ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for owning the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path rfs:hasProjectVerifier ],
        [ sh:class rfs:Impact ;
            sh:description "Co-benefits are any secondary impacts that may result from adhering to the protocol and/or management practices associated with the credit class. They can be qualitative or quantitative." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path rfs:hasCoBenefits ],
        [ sh:datatype xsd:string ;
            sh:description "The end date of the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:endDate ],
        [ sh:class geo:Feature ;
            sh:description "The location of the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path rfs:hasFeature ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for operating the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path rfs:hasProjectOperator ],
        [ sh:class rfs:Link ;
            sh:description "A list of links associated with the project." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:hasLinks ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:name ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for owning the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path rfs:hasProjectDeveloper ],
        [ sh:class rfs:Impact ;
            sh:description "The primary impact expected from adhering to the protocol and/or management practices associated with the credit class. Generally speaking the quantifiable components of this impact are associated with the credit type that the credit class exists under (e.g. Carbon, Biodiversity, etc)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path rfs:hasPrimaryImpact ],
        [ sh:class rfs:Methodology ;
            sh:description "The methodology that the project uses." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path rfs:usesMethodology ] ;
    sh:targetClass rfs:C02ProjectInfo .

rfs:C06CohortClaim a sh:NodeShape ;
    rdfs:comment "The project developer's assertions about one cohort: its crediting and permanence periods." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path schema1:url ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the claimant presents as evidence for the assertion, each an Evidence node identified by the IRI of the exact version cited. Whether a source actually supports the assertion is judged separately, by attestations. Specializes dcterms:references. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path rfs:hasEvidence ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion as the claimant states it in natural language. This is asserted content, not a presentational summary: changing it changes the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:description ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises, typically its ClaimIRI. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its attestations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasRevisionOf ],
        [ sh:class rfs:Entity ;
            sh:description "The agent or agents that take responsibility for making this assertion: an individual, organization or community. Each listed claimant takes responsibility for the whole assertion. A collective that asserts as one body is a single claimant of type COMMUNITY or ORGANIZATION; listing it does not make its members co-claimants. A service that extracted, generated or submitted the RDF is not a claimant unless it asserts the content itself. Specializes prov:wasAttributedTo, so under PROV each claimant is an agent associated with the activity that generated the Claim, which is the act of asserting. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path rfs:hasClaimant ],
        [ sh:class rfs:DatePeriod ;
            sh:description "The period during which credits can be issued for the subject. In an aggregate project, cohorts and sites may have their own." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path rfs:creditingPeriod ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable title of the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:name ],
        [ sh:class rfs:Cohort ;
            sh:description "What the claim is about, as a ClaimSubject node identified by its IRI: a place, plot, project, organization, community, indicator, dataset or another claim. Claims about the same subject share its IRI and can be joined. Specialized claim schemas narrow the range to a subclass of ClaimSubject. Not the claimant, and not necessarily the feature of interest of an observation inside the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path rfs:hasSubject ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the claimants made this assertion. For an assertion they made in a source document, such as a project plan, and that was transcribed later, it is when they made it there, not when it was extracted, transcribed or submitted. It is never the time of an observation, or the time the Claim record was generated, submitted, published or ingested. The same content asserted at a different time is a different Claim. Written in UTC with whole seconds, in the XSD canonical form, for example 2026-05-02T07:30:00Z. A local offset is not accepted." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" ],
        [ sh:class rfs:DatePeriod ;
            sh:description "The period after the crediting period during which the carbon stored must be maintained." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path rfs:permanencePeriod ] ;
    sh:targetClass rfs:C06CohortClaim .

rfs:C06PlotClaim a sh:NodeShape ;
    rdfs:comment "The project developer's assertions about one plot: its area and boundary, its tenure basis, and whether it was converted from a natural ecosystem. The land register records and land cover datasets behind them are cited as evidence." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class rfs:Evidence ;
            sh:description "Sources the claimant presents as evidence for the assertion, each an Evidence node identified by the IRI of the exact version cited. Whether a source actually supports the assertion is judged separately, by attestations. Specializes dcterms:references. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rfs:hasEvidence ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the plot was converted from forest land, wetland or another natural ecosystem in the ten years before its site's project start date." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rfs:convertedFromNaturalEcosystem ],
        [ sh:description "The legal basis on which the plot is controlled during the crediting period: ownership, a lease, or another arrangement." ;
            sh:in ( rfs:Ownership rfs:Lease rfs:OtherTenure ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path rfs:tenureBasis ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises, typically its ClaimIRI. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its attestations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path prov:wasRevisionOf ],
        [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion as the claimant states it in natural language. This is asserted content, not a presentational summary: changing it changes the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path schema1:description ],
        [ sh:description "Identifier of the boundary feature, for example a feature in a cited GeoPackage. One feature may cover more than one plot." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rfs:geometry ],
        [ sh:class rfs:Entity ;
            sh:description "The agent or agents that take responsibility for making this assertion: an individual, organization or community. Each listed claimant takes responsibility for the whole assertion. A collective that asserts as one body is a single claimant of type COMMUNITY or ORGANIZATION; listing it does not make its members co-claimants. A service that extracted, generated or submitted the RDF is not a claimant unless it asserts the content itself. Specializes prov:wasAttributedTo, so under PROV each claimant is an agent associated with the activity that generated the Claim, which is the act of asserting. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path rfs:hasClaimant ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable title of the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:name ],
        [ sh:class qudt:QuantityValue ;
            sh:description "Area, as a QUDT quantity value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path rfs:area ],
        [ sh:class rfs:Plot ;
            sh:description "What the claim is about, as a ClaimSubject node identified by its IRI: a place, plot, project, organization, community, indicator, dataset or another claim. Claims about the same subject share its IRI and can be joined. Specialized claim schemas narrow the range to a subclass of ClaimSubject. Not the claimant, and not necessarily the feature of interest of an observation inside the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path rfs:hasSubject ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the claimants made this assertion. For an assertion they made in a source document, such as a project plan, and that was transcribed later, it is when they made it there, not when it was extracted, transcribed or submitted. It is never the time of an observation, or the time the Claim record was generated, submitted, published or ingested. The same content asserted at a different time is a different Claim. Written in UTC with whole seconds, in the XSD canonical form, for example 2026-05-02T07:30:00Z. A local offset is not accepted." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" ] ;
    sh:targetClass rfs:C06PlotClaim .

rfs:C06ProjectClaim a sh:NodeShape ;
    rdfs:comment "The project developer's assertions about the whole project: the rule sets and methodologies it applies, that it is an aggregate project, its start and adoption dates, crediting and permanence periods, and the deviations it requests." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class rfs:Evidence ;
            sh:description "Sources the claimant presents as evidence for the assertion, each an Evidence node identified by the IRI of the exact version cited. Whether a source actually supports the assertion is judged separately, by attestations. Specializes dcterms:references. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path rfs:hasEvidence ],
        [ sh:datatype xsd:boolean ;
            sh:description "True when the project is an aggregate project: a group of sites, each individually identifiable, registered as one project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rfs:isAggregateProject ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion as the claimant states it in natural language. This is asserted content, not a presentational summary: changing it changes the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema1:description ],
        [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path schema1:url ],
        [ sh:description "Identifier of an exact version of a normative rule set applied, such as a credit class, a methodology or a program guide version. It is content and enters the identity of the record. It is distinct from a schema-version declaration, which states which schema the RDF conforms to. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rfs:appliesRuleSet ],
        [ sh:datatype xsd:string ;
            sh:description "The event or record that establishes the start date, for example the first baseline soil sampling or a contract signature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path rfs:startDateBasis ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises, typically its ClaimIRI. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its attestations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path prov:wasRevisionOf ],
        [ sh:datatype xsd:date ;
            sh:description "When the project activities were adopted." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rfs:adoptionDate ],
        [ sh:class rfs:Entity ;
            sh:description "The agent or agents that take responsibility for making this assertion: an individual, organization or community. Each listed claimant takes responsibility for the whole assertion. A collective that asserts as one body is a single claimant of type COMMUNITY or ORGANIZATION; listing it does not make its members co-claimants. A service that extracted, generated or submitted the RDF is not a claimant unless it asserts the content itself. Specializes prov:wasAttributedTo, so under PROV each claimant is an agent associated with the activity that generated the Claim, which is the act of asserting. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path rfs:hasClaimant ],
        [ sh:datatype xsd:date ;
            sh:description "Start date of the aggregate project. Each site also has its own start date (siteProjectStartDate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rfs:aggregateStartDate ],
        [ sh:class rfs:DatePeriod ;
            sh:description "The period during which credits can be issued for the subject. In an aggregate project, cohorts and sites may have their own." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path rfs:creditingPeriod ],
        [ sh:class rfs:MethodologyUse ;
            sh:description "The methodology versions the project applies, each with its role and what it is used for. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path rfs:methodologyUse ],
        [ sh:class rfs:DeviationRequest ;
            sh:description "Project-specific deviations from requirements that the project developer requests in its project plan, each naming the requirements it replaces. Whether a deviation is approved is a separate attestation. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:requestedDeviations ],
        [ sh:class rfs:Project ;
            sh:description "What the claim is about, as a ClaimSubject node identified by its IRI: a place, plot, project, organization, community, indicator, dataset or another claim. Claims about the same subject share its IRI and can be joined. Specialized claim schemas narrow the range to a subclass of ClaimSubject. Not the claimant, and not necessarily the feature of interest of an observation inside the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path rfs:hasSubject ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable title of the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:name ],
        [ sh:class rfs:DatePeriod ;
            sh:description "The period after the crediting period during which the carbon stored must be maintained." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path rfs:permanencePeriod ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the claimants made this assertion. For an assertion they made in a source document, such as a project plan, and that was transcribed later, it is when they made it there, not when it was extracted, transcribed or submitted. It is never the time of an observation, or the time the Claim record was generated, submitted, published or ingested. The same content asserted at a different time is a different Claim. Written in UTC with whole seconds, in the XSD canonical form, for example 2026-05-02T07:30:00Z. A local offset is not accepted." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" ] ;
    sh:targetClass rfs:C06ProjectClaim .

rfs:C06ProjectStatementClaim a sh:NodeShape ;
    rdfs:comment "A statement the project developer makes about the project that a reviewer reads rather than checks as a value, such as how local stakeholders were consulted, the basis of the aggregation, or that no sites are enrolled after a cutoff date. The assertion is in description and its location in the project plan is the evidence; which requirement it answers is recorded by the reviewer's attestation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path schema1:url ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the claimant presents as evidence for the assertion, each an Evidence node identified by the IRI of the exact version cited. Whether a source actually supports the assertion is judged separately, by attestations. Specializes dcterms:references. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path rfs:hasEvidence ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises, typically its ClaimIRI. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its attestations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasRevisionOf ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion as the claimant states it in natural language. This is asserted content, not a presentational summary: changing it changes the Claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:class rfs:Entity ;
            sh:description "The agent or agents that take responsibility for making this assertion: an individual, organization or community. Each listed claimant takes responsibility for the whole assertion. A collective that asserts as one body is a single claimant of type COMMUNITY or ORGANIZATION; listing it does not make its members co-claimants. A service that extracted, generated or submitted the RDF is not a claimant unless it asserts the content itself. Specializes prov:wasAttributedTo, so under PROV each claimant is an agent associated with the activity that generated the Claim, which is the act of asserting. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path rfs:hasClaimant ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable title of the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the claimants made this assertion. For an assertion they made in a source document, such as a project plan, and that was transcribed later, it is when they made it there, not when it was extracted, transcribed or submitted. It is never the time of an observation, or the time the Claim record was generated, submitted, published or ingested. The same content asserted at a different time is a different Claim. Written in UTC with whole seconds, in the XSD canonical form, for example 2026-05-02T07:30:00Z. A local offset is not accepted." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" ],
        [ sh:class rfs:Project ;
            sh:description "What the claim is about, as a ClaimSubject node identified by its IRI: a place, plot, project, organization, community, indicator, dataset or another claim. Claims about the same subject share its IRI and can be joined. Specialized claim schemas narrow the range to a subclass of ClaimSubject. Not the claimant, and not necessarily the feature of interest of an observation inside the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rfs:hasSubject ] ;
    sh:targetClass rfs:C06ProjectStatementClaim .

rfs:C06SiteClaim a sh:NodeShape ;
    rdfs:comment "The project developer's assertions about one site: its start date and crediting period, ecosystem types, climate and soil classes, practices, primary land use and soil monitoring schedule. Records of its historic activity are cited as evidence." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The assertion as the claimant states it in natural language. This is asserted content, not a presentational summary: changing it changes the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:description ],
        [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path schema1:url ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the claimant presents as evidence for the assertion, each an Evidence node identified by the IRI of the exact version cited. Whether a source actually supports the assertion is judged separately, by attestations. Specializes dcterms:references. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path rfs:hasEvidence ],
        [ sh:description "Ecosystem types of the site, as taxonomy terms such as cropland or pastureland. Unordered set." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:order 3 ;
            sh:path rfs:ecosystemTypes ],
        [ sh:datatype xsd:string ;
            sh:description "World Reference Base soil group, for example Cambisol." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rfs:soilGroup ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises, typically its ClaimIRI. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its attestations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path prov:wasRevisionOf ],
        [ sh:datatype xsd:date ;
            sh:description "Dates of soil sampling at the site." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path rfs:monitoringSampleDates ],
        [ sh:datatype xsd:string ;
            sh:description "The event or record that establishes the start date, for example the first baseline soil sampling or a contract signature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:startDateBasis ],
        [ sh:description "The site's primary land use, as a taxonomy term, which the site must maintain during its project period." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path rfs:primaryLandUse ],
        [ sh:class rfs:DatePeriod ;
            sh:description "The period during which credits can be issued for the subject. In an aggregate project, cohorts and sites may have their own." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path rfs:creditingPeriod ],
        [ sh:description "Practices implemented on the site." ;
            sh:in ( rft:ResidueTillageManagement rft:BiocharProduction rft:ImprovedForestManagement rft:Agroforestry rft:PrescribedGrazing rft:RiparianForestBuffers rft:SoilAmendments rft:Conservation rft:Ecotourism rft:CoverCropping rft:TreePlanting rft:PhotocatalystApplication rft:EcosystemRestoration rft:IndustrialBiocharProduction rft:ArtisanalBiocharProduction rft:Biochar rft:EnhancedRockWeathering rft:CompostAmendments rft:KeystoneSpeciesConservation rft:UmbrellaSpeciesConservation rft:Silvopasture rft:ForestFarming rft:NonUrbanForestImprovement rft:UrbanForestImprovement rft:Afforestation rft:Reforestation ) ;
            sh:order 6 ;
            sh:path rfs:practices ],
        [ sh:datatype xsd:string ;
            sh:description "Why sampling intervals differ from the expected cadence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path rfs:monitoringIntervalJustification ],
        [ sh:datatype xsd:date ;
            sh:description "The site's own project start date. In an aggregate project each site defines its own, which may differ from the aggregate's; its basis is stated in startDateBasis." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:siteProjectStartDate ],
        [ sh:class rfs:Entity ;
            sh:description "The agent or agents that take responsibility for making this assertion: an individual, organization or community. Each listed claimant takes responsibility for the whole assertion. A collective that asserts as one body is a single claimant of type COMMUNITY or ORGANIZATION; listing it does not make its members co-claimants. A service that extracted, generated or submitted the RDF is not a claimant unless it asserts the content itself. Specializes prov:wasAttributedTo, so under PROV each claimant is an agent associated with the activity that generated the Claim, which is the act of asserting. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path rfs:hasClaimant ],
        [ sh:datatype xsd:string ;
            sh:description "Köppen-Geiger climate class, for example Dfb." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path rfs:climateClass ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable title of the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema1:name ],
        [ sh:class rfs:Site ;
            sh:description "What the claim is about, as a ClaimSubject node identified by its IRI: a place, plot, project, organization, community, indicator, dataset or another claim. Claims about the same subject share its IRI and can be joined. Specialized claim schemas narrow the range to a subclass of ClaimSubject. Not the claimant, and not necessarily the feature of interest of an observation inside the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path rfs:hasSubject ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the claimants made this assertion. For an assertion they made in a source document, such as a project plan, and that was transcribed later, it is when they made it there, not when it was extracted, transcribed or submitted. It is never the time of an observation, or the time the Claim record was generated, submitted, published or ingested. The same content asserted at a different time is a different Claim. Written in UTC with whole seconds, in the XSD canonical form, for example 2026-05-02T07:30:00Z. A local offset is not accepted." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" ] ;
    sh:targetClass rfs:C06SiteClaim .

rfs:CarbonCreditClassInfo a sh:NodeShape ;
    rdfs:comment "Off-chain metadata representation for credit classes where the credit type is Carbon (C)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:duration ;
            sh:description "The total duration of the crediting term for the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path rfs:hasCreditingPeriod ],
        [ sh:description "Types of environments that a project registered under this credit class may focuses on." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:minCount 1 ;
            sh:order 12 ;
            sh:path rfs:eligibleEnvironmentTypes ],
        [ sh:description "Method for generating credits." ;
            sh:in ( "AVOIDED_EMISSIONS" "CARBON_DIOXIDE_REMOVAL" "EMISSIONS_REDUCTION" ) ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path rfs:hasCreditGenerationMethod ],
        [ sh:class rfs:Methodology ;
            sh:description "If one or more standalone methodologies for quantifying GHG or other benefits are approved for use, supplemental to any explicit methodlogies defined within the main creditProtocol document, they can be listed here." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path rfs:hasApprovedMethodologies ],
        [ sh:datatype xsd:duration ;
            sh:description "Permanence period of the credits." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:hasPermanencePeriod ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:description ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path schema1:url ],
        [ sh:description "Eligible activities for projects registered under this credit class." ;
            sh:in ( rft:ResidueTillageManagement rft:BiocharProduction rft:ImprovedForestManagement rft:Agroforestry rft:PrescribedGrazing rft:RiparianForestBuffers rft:SoilAmendments rft:Conservation rft:Ecotourism rft:CoverCropping rft:TreePlanting rft:PhotocatalystApplication rft:EcosystemRestoration rft:IndustrialBiocharProduction rft:ArtisanalBiocharProduction rft:Biochar rft:EnhancedRockWeathering rft:CompostAmendments rft:KeystoneSpeciesConservation rft:UmbrellaSpeciesConservation rft:Silvopasture rft:ForestFarming rft:NonUrbanForestImprovement rft:UrbanForestImprovement rft:Afforestation rft:Reforestation ) ;
            sh:minCount 1 ;
            sh:order 13 ;
            sh:path rfs:eligibleActivities ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:name ],
        [ sh:class rfs:CreditingProgram ;
            sh:description "The higher-level rules and requirements under which the given credit protocol operates, sometimes referred to as the \"Standard\"." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:managedUnderProgram ],
        [ sh:class rfs:CreditProtocol ;
            sh:description "The root document of the credit protocol that defines the requirements and process to register and issue credits under a credit protocol. It could be registered under a program or independent. It could include methods to measure and monitor, or reference other methodology documents." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path rfs:hasCreditProtocol ],
        [ sh:class rfs:Impact ;
            sh:description "Co-benefits are any secondary impacts that may result from adhering to the protocol and/or management practices associated with the credit class. They can be qualitative or quantitative." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path rfs:hasCoBenefits ],
        [ sh:class rfs:Registry ;
            sh:description "The registry where the credits are originally issued and tracked if somewhere other than Regen Network." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path rfs:hasSourceRegistry ],
        [ sh:class rfs:BufferPoolAccount ;
            sh:description "Buffer pool accounts associated with the credit class." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path rfs:hasBufferPoolAccounts ],
        [ sh:class rfs:Impact ;
            sh:description "The primary impact expected from adhering to the protocol and/or management practices associated with the credit class. Generally speaking the quantifiable components of this impact are associated with the credit type that the credit class exists under (e.g. Carbon, Biodiversity, etc)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path rfs:hasPrimaryImpact ] ;
    sh:targetClass rfs:CarbonCreditClassInfo .

rfs:Claim a sh:NodeShape ;
    rdfs:comment "An attributed assertion: related statements that one or more identified claimants present together about a subject, at a stated time. A Claim is asserted by definition, so it is self-attested by its claimants and is valid without any third-party attestation; later reviews are separate resources that point to it. An unasserted authoring candidate, such as an extraction draft without a claimant, is not a Claim. Every version is immutable: a correction is a new Claim that states wasRevisionOf." ;
    sh:closed true ;
    sh:ignoredProperties ( rfs:permanencePeriod rfs:issuerRole rfs:outcome rfs:hasTarget rfs:rationale rfs:verificationMethodDescriptor rfs:creditingPeriod rfs:startDateBasis rfs:primaryLandUse rfs:climateClass rdf:type rfs:siteProjectStartDate rfs:adoptionDate rfs:unbounded rfs:soilGroup rfs:findingLabel rfs:practices rfs:ecosystemTypes rfs:monitoringIntervalJustification rfs:conditions rfs:aggregateStartDate rfs:area rfs:verificationMethod rfs:convertedFromNaturalEcosystem rfs:methodologyUse rfs:appliesRuleSet rfs:scope rfs:tenureBasis rfs:requestedDeviations rfs:geometry rfs:findingType rfs:requirement rfs:reliesOn rfs:isAggregateProject rfs:monitoringSampleDates ) ;
    sh:property [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path schema1:url ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the claimant presents as evidence for the assertion, each an Evidence node identified by the IRI of the exact version cited. Whether a source actually supports the assertion is judged separately, by attestations. Specializes dcterms:references. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path rfs:hasEvidence ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion as the claimant states it in natural language. This is asserted content, not a presentational summary: changing it changes the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises, typically its ClaimIRI. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its attestations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasRevisionOf ],
        [ sh:class rfs:Entity ;
            sh:description "The agent or agents that take responsibility for making this assertion: an individual, organization or community. Each listed claimant takes responsibility for the whole assertion. A collective that asserts as one body is a single claimant of type COMMUNITY or ORGANIZATION; listing it does not make its members co-claimants. A service that extracted, generated or submitted the RDF is not a claimant unless it asserts the content itself. Specializes prov:wasAttributedTo, so under PROV each claimant is an agent associated with the activity that generated the Claim, which is the act of asserting. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path rfs:hasClaimant ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable title of the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the claimants made this assertion. For an assertion they made in a source document, such as a project plan, and that was transcribed later, it is when they made it there, not when it was extracted, transcribed or submitted. It is never the time of an observation, or the time the Claim record was generated, submitted, published or ingested. The same content asserted at a different time is a different Claim. Written in UTC with whole seconds, in the XSD canonical form, for example 2026-05-02T07:30:00Z. A local offset is not accepted." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" ],
        [ sh:class rfs:ClaimSubject ;
            sh:description "What the claim is about, as a ClaimSubject node identified by its IRI: a place, plot, project, organization, community, indicator, dataset or another claim. Claims about the same subject share its IRI and can be joined. Specialized claim schemas narrow the range to a subclass of ClaimSubject. Not the claimant, and not necessarily the feature of interest of an observation inside the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rfs:hasSubject ] ;
    sh:targetClass rfs:Claim .


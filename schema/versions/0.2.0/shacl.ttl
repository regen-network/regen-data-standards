rfs:ProjectPost a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class rfs:File ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:references ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ] ;
    sh:targetClass rfs:ProjectPost .

rfs:RegistryFindingAttestation a sh:NodeShape ;
    rdfs:comment "A finding raised in a Regen Registry review: a corrective action, clarification or forward action request, or a material issue raised by the Registry Agent. A finding states its type and cites at least one piece of evidence (story map CS-3). Later assessments of the finding and replies to it are RegistryReviewAttestations that target it and carry the same findingLabel." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "What an attestation judges or answers: the identifier of an exact, immutable version of a claim, of another attestation, or of a snapshot (a fixed set of claim versions). Never a logical identifier or label. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path rfs:hasTarget ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion as the claimant states it in natural language. This is asserted content, not a presentational summary: changing it changes the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:boolean ;
            sh:description "True when the issuer explicitly gives the judgment no limits beyond what it targets (story map AD-1), so that an unlimited approval is a stated choice rather than an omission. An attestation that states it has no scope." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path rfs:unbounded ],
        [ sh:description "Identifier of an exact version of a normative rule set applied, such as a credit class, a methodology or a program guide version. It is content and enters the identity of the record. It is distinct from a schema-version declaration, which states which schema the RDF conforms to. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path rfs:appliesRuleSet ],
        [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path schema1:url ],
        [ sh:description "Identifier of a requirement within one version of a rule set or checklist, for example a credit class registration requirement. The identifier must name the checklist version as well as the requirement, because the same short ID can name different requirements in different versions. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path rfs:requirement ],
        [ sh:datatype xsd:string ;
            sh:description "Why the issuer reached the outcome." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path rfs:rationale ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of a verification method that the VerificationMethodType enumeration does not cover; required when verificationMethod is OTHER. It is the extension path: a method that recurs is added to the enumeration in a later schema version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path rfs:verificationMethodDescriptor ],
        [ sh:description "Exact versions of claims or attestations that a judgment depends on without judging them, for example the claim stating an enrolment cutoff that an approval relies on. Each value is the identifier of one immutable version. Specializes dcterms:references, so it asserts neither derivation nor support. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rfs:reliesOn ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises, typically its ClaimIRI. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its attestations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path prov:wasRevisionOf ],
        [ sh:description "The kind of finding." ;
            sh:in ( rfs:CorrectiveActionRequest rfs:ClarificationRequest rfs:ForwardActionRequest rfs:RegistryIssue rfs:OtherFindingType ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path rfs:findingType ],
        [ sh:datatype xsd:string ;
            sh:description "The issuer's own identifier for a finding, stable across review rounds, such as \"CL 07(1)\". It groups the dated records about one finding; it is not the identifier of any of them." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:findingLabel ],
        [ sh:class rfs:Entity ;
            sh:description "The issuer: the party that makes the judgment and takes responsibility for it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path rfs:hasClaimant ],
        [ sh:description "How the assertion or judgment was established, as structured data, so that a consumer can distinguish, for example, a lab-measured value from a self-attested one. One method per record: its party and date are those of the record that carries it (for an attestation, its issuer and assertedAt), so a subject checked by two methods has two records, each with its own party and date. A value of OTHER must come with verificationMethodDescriptor." ;
            sh:in ( rfs:SelfAttested rfs:PeerOrCommunity rfs:LabMeasured rfs:SensorDerived rfs:ModelEstimated rfs:ThirdPartyAudited rfs:OtherVerificationMethod ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 10 ;
            sh:path rfs:verificationMethod ],
        [ sh:class rfs:Scope ;
            sh:description "Where the judgment applies: the subjects it covers, what it explicitly excludes, and what it does not establish." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path rfs:scope ],
        [ sh:description "The capacity in which the issuer acts, so that a consumer can check the issuer's authority for the decision." ;
            sh:in ( rfs:RegistryAgent rfs:ValidationVerificationBody rfs:CreditClassAdmin rfs:OtherIssuerRole ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path rfs:issuerRole ],
        [ sh:description "The verdict, as the IRI of a RegistryReviewOutcome term, for example rfs:ApprovedForRegistration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path rfs:outcome ],
        [ sh:class rfs:ClaimSubject ;
            sh:description "What the judgment is about: a project, plot or other subject. It is stated even when it is also the subject of a targeted claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path rfs:hasSubject ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the issuer relied on." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path rfs:hasEvidence ],
        [ sh:class rfs:Condition ;
            sh:description "Obligations the judgment carries to a later milestone, such as follow-up actions due before verification. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path rfs:conditions ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the issuer made the judgment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable title of the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:RegistryFindingAttestation .

rfs:RegistryReviewAttestation a sh:NodeShape ;
    rdfs:comment "A judgment made in a Regen Registry review by the Registry Agent, an independent verifier (VVB) or the Credit Class Admin." ;
    sh:closed true ;
    sh:ignoredProperties ( rfs:findingType rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "True when the issuer explicitly gives the judgment no limits beyond what it targets (story map AD-1), so that an unlimited approval is a stated choice rather than an omission. An attestation that states it has no scope." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path rfs:unbounded ],
        [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion as the claimant states it in natural language. This is asserted content, not a presentational summary: changing it changes the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path schema1:description ],
        [ sh:description "What an attestation judges or answers: the identifier of an exact, immutable version of a claim, of another attestation, or of a snapshot (a fixed set of claim versions). Never a logical identifier or label. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rfs:hasTarget ],
        [ sh:description "Exact versions of claims or attestations that a judgment depends on without judging them, for example the claim stating an enrolment cutoff that an approval relies on. Each value is the identifier of one immutable version. Specializes dcterms:references, so it asserts neither derivation nor support. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path rfs:reliesOn ],
        [ sh:description "Identifier of an exact version of a normative rule set applied, such as a credit class, a methodology or a program guide version. It is content and enters the identity of the record. It is distinct from a schema-version declaration, which states which schema the RDF conforms to. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path rfs:appliesRuleSet ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of a verification method that the VerificationMethodType enumeration does not cover; required when verificationMethod is OTHER. It is the extension path: a method that recurs is added to the enumeration in a later schema version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path rfs:verificationMethodDescriptor ],
        [ sh:description "Identifier of a requirement within one version of a rule set or checklist, for example a credit class registration requirement. The identifier must name the checklist version as well as the requirement, because the same short ID can name different requirements in different versions. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rfs:requirement ],
        [ sh:datatype xsd:string ;
            sh:description "Why the issuer reached the outcome." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path rfs:rationale ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises, typically its ClaimIRI. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its attestations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path prov:wasRevisionOf ],
        [ sh:class rfs:Condition ;
            sh:description "Obligations the judgment carries to a later milestone, such as follow-up actions due before verification. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path rfs:conditions ],
        [ sh:description "The verdict, as the IRI of a RegistryReviewOutcome term, for example rfs:ApprovedForRegistration." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path rfs:outcome ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the issuer relied on." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path rfs:hasEvidence ],
        [ sh:datatype xsd:string ;
            sh:description "The issuer's own identifier for a finding, stable across review rounds, such as \"CL 07(1)\". It groups the dated records about one finding; it is not the identifier of any of them." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:findingLabel ],
        [ sh:class rfs:Scope ;
            sh:description "Where the judgment applies: the subjects it covers, what it explicitly excludes, and what it does not establish." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path rfs:scope ],
        [ sh:class rfs:Entity ;
            sh:description "The issuer: the party that makes the judgment and takes responsibility for it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path rfs:hasClaimant ],
        [ sh:class rfs:ClaimSubject ;
            sh:description "What the judgment is about: a project, plot or other subject. It is stated even when it is also the subject of a targeted claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path rfs:hasSubject ],
        [ sh:description "The capacity in which the issuer acts, so that a consumer can check the issuer's authority for the decision." ;
            sh:in ( rfs:RegistryAgent rfs:ValidationVerificationBody rfs:CreditClassAdmin rfs:OtherIssuerRole ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path rfs:issuerRole ],
        [ sh:description "How the assertion or judgment was established, as structured data, so that a consumer can distinguish, for example, a lab-measured value from a self-attested one. One method per record: its party and date are those of the record that carries it (for an attestation, its issuer and assertedAt), so a subject checked by two methods has two records, each with its own party and date. A value of OTHER must come with verificationMethodDescriptor." ;
            sh:in ( rfs:SelfAttested rfs:PeerOrCommunity rfs:LabMeasured rfs:SensorDerived rfs:ModelEstimated rfs:ThirdPartyAudited rfs:OtherVerificationMethod ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 9 ;
            sh:path rfs:verificationMethod ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the issuer made the judgment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable title of the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:RegistryReviewAttestation .

rfs:VersionedLink a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version number of the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:version ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:VersionedLink .

linkml:Any a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass linkml:Any .

rfs:Activity a sh:NodeShape ;
    rdfs:comment "Something that took place over a period, identified by an IRI so that every piece of evidence it generated names the same activity. Its period is given as dates; prov:startedAtTime and prov:endedAtTime would require timestamps." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:class rfs:Entity ;
            sh:description "Responsibility of an agent for an activity (PROV), for example the farm operator who carried out the field operations a record documents. Claim-type schemas that describe a domain activity, such as a restoration, name its operator the same way. Use it only on a class that represents an activity (its PROV domain is prov:Activity); such classes declare the ProvActivity mixin. It is not attribution of a Claim: the operator and the claimant may differ, and when they coincide both relations are still stated." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype xsd:date ;
            sh:description "First day of the period, included." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:startDate ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:description "IRI of the activity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rfs:id ],
        [ sh:datatype xsd:date ;
            sh:description "Last day of the period, included." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:endDate ] ;
    sh:targetClass rfs:Activity .

rfs:Cohort a sh:NodeShape ;
    rdfs:comment "The sites of a project whose baseline soil sampling took place in the same year. Each cohort has its own crediting and permanence periods, and approvals can be scoped to cohorts." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Identifier of the project this subject belongs to." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rfs:project ],
        [ sh:description "IRI or CURIE of the subject, for example https://example.org/plot/A." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rfs:id ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name of the subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:integer ;
            sh:description "Year of the cohort's baseline soil sampling." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:baselineYear ] ;
    sh:targetClass rfs:Cohort .

rfs:ContentDigest a sh:NodeShape ;
    rdfs:comment "A cryptographic hash of the bytes of the cited source version: the whole file, not the position a fragment points to. A reader recomputes it over the bytes the resolver returns to check that they are the bytes cited." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( rfs:SHA256 rfs:BLAKE2b256 ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path rfs:algorithm ],
        [ sh:datatype xsd:string ;
            sh:description "Lowercase hexadecimal digest." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:digestValue ;
            sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:targetClass rfs:ContentDigest .

rfs:DeviationRequest a sh:NodeShape ;
    rdfs:comment "A project-specific deviation from a requirement that the project developer requests. Whether it is approved is a separate attestation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Identifier of a requirement within one version of a rule set or checklist, for example a credit class registration requirement. The identifier must name the checklist version as well as the requirement, because the same short ID can name different requirements in different versions. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rfs:requirement ],
        [ sh:datatype xsd:string ;
            sh:description "Why the deviation is requested, including why it is as conservative as the requirement it replaces." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rfs:justification ],
        [ sh:datatype xsd:string ;
            sh:description "What the deviation replaces, and with what." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:replacedParameters ] ;
    sh:targetClass rfs:DeviationRequest .

rfs:File a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:creator ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:iri ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:class geo:Geometry ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path geo:hasGeometry ] ;
    sh:targetClass rfs:File .

rfs:ManagementArea a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "the activity" ;
            sh:in ( rft:ResidueTillageManagement rft:BiocharProduction rft:ImprovedForestManagement rft:Agroforestry rft:PrescribedGrazing rft:RiparianForestBuffers rft:SoilAmendments rft:Conservation rft:Ecotourism rft:CoverCropping rft:TreePlanting rft:PhotocatalystApplication rft:EcosystemRestoration rft:IndustrialBiocharProduction rft:ArtisanalBiocharProduction rft:Biochar rft:EnhancedRockWeathering rft:CompostAmendments rft:KeystoneSpeciesConservation rft:UmbrellaSpeciesConservation rft:Silvopasture rft:ForestFarming rft:NonUrbanForestImprovement rft:UrbanForestImprovement rft:Afforestation rft:Reforestation ) ;
            sh:order 0 ;
            sh:path rfs:projectActivity ],
        [ sh:class qudt:QuantityValue ;
            sh:description "the extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dcterms:extent ] ;
    sh:targetClass rfs:ManagementArea .

rfs:MethodologyUse a sh:NodeShape ;
    rdfs:comment "A methodology version the project applies, and for what." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Identifier of an exact methodology version." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rfs:methodology ],
        [ sh:datatype xsd:string ;
            sh:description "What the methodology is used for in this project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rfs:methodologyScope ],
        [ sh:description "Whether the methodology is the project's primary quantification methodology or a supplementary one, used for part of the assessment such as the baseline or leakage." ;
            sh:in ( rfs:PrimaryMethodology rfs:SupplementaryMethodology ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path rfs:methodologyRole ] ;
    sh:targetClass rfs:MethodologyUse .

rfs:Plot a sh:NodeShape ;
    rdfs:comment "One land parcel of a site. The plots of a site are the plots whose site is that site." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "IRI or CURIE of the subject, for example https://example.org/plot/A." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path rfs:id ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of the parcel in the national land parcel register, for example LPIS in Czechia or GSAA in Slovakia." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:parcelId ],
        [ sh:datatype xsd:string ;
            sh:description "The key that identifies the plot in the project's records." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:plotKey ],
        [ sh:description "Identifier of the plot's site." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rfs:site ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name of the subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:Plot .

rfs:Site a sh:NodeShape ;
    rdfs:comment "One enrolled site (farm) of an aggregate project." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Identifier of the project this subject belongs to." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rfs:project ],
        [ sh:description "IRI or CURIE of the subject, for example https://example.org/plot/A." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rfs:id ],
        [ sh:datatype xsd:string ;
            sh:description "ISO 3166-1 alpha-2 country code." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:addressCountry ;
            sh:pattern "^[A-Z]{2}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name of the subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:name ],
        [ sh:description "Identifier of the site's cohort." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rfs:cohort ],
        [ sh:datatype xsd:string ;
            sh:description "The key that identifies the site in the project's records." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:siteKey ] ;
    sh:targetClass rfs:Site .

rfs:BufferPoolAccount a sh:NodeShape ;
    rdfs:comment "Details of the buffer pool account associated with a credit class." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The allocation of the buffer pool." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rfs:poolAllocation ;
            sh:pattern "^\\d+(\\.\\d+)?%$" ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "The wallet address of the buffer pool account." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:walletAddress ;
            sh:pattern "^regen1[0-9a-zA-Z]+$" ] ;
    sh:targetClass rfs:BufferPoolAccount .

rfs:Condition a sh:NodeShape ;
    rdfs:comment "An obligation a judgment carries to a later milestone, such as a follow-up action due before verification or a design condition binding on future verifications." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "When the condition must be met." ;
            sh:in ( rfs:RegistrationMilestone rfs:PreIssuanceMilestone rfs:VerificationMilestone rfs:FutureVerificationsMilestone ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path rfs:milestone ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "The issuer's label for the condition, such as \"RA-6\"." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:conditionLabel ] ;
    sh:targetClass rfs:Condition .

rfs:CreditProtocol a sh:NodeShape ;
    rdfs:comment "Details of the credit protocol that defines the requirements and process to register and issue credits under a credit protocol. Credit Protocols can be registered under a program or independent. It could include specific methods to measure and monitor, or reference other methodology documents." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version number of the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:version ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:CreditProtocol .

rfs:CreditingProgram a sh:NodeShape ;
    rdfs:comment "Details of the program that oversees the crediting protocol associated with this credit class." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version number of the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:version ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:CreditingProgram .

rfs:Project a sh:NodeShape ;
    rdfs:comment "An aggregate project of enrolled sites." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The project's identifier in the registry, once assigned." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:registryProjectId ],
        [ sh:description "IRI or CURIE of the subject, for example https://example.org/plot/A." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rfs:id ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name of the subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:Project .

rfs:Registry a sh:NodeShape ;
    rdfs:comment "Details of the registry where the credits are tracked." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:Registry .

rfs:Scope a sh:NodeShape ;
    rdfs:comment "Where an attestation applies, as structured fields, so that a consumer can check whether a subject falls inside it. A scope always names the subjects it covers. An attestation without a scope applies only to what it targets, unless it states unbounded." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "What the judgment is not, for example that an approval of a project structure is not a validation of its evidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rfs:limitation ],
        [ sh:description "Identifiers of the subjects the judgment covers, for example the enrolment cohorts an approval is limited to. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rfs:appliesTo ],
        [ sh:datatype xsd:string ;
            sh:description "What the judgment explicitly does not cover. Unordered set." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:exclusion ] ;
    sh:targetClass rfs:Scope .

geo:Geometry a sh:NodeShape ;
    rdfs:comment "A geometry defined using Well-Known Text (WKT), compliant with GeoSPARQL 1.1." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A WKT literal with an optional CRS prefix (e.g., '<http://www.opengis.net/def/crs/EPSG/0/4326> POINT(...)')." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path geo:asWKT ] ;
    sh:targetClass geo:Geometry .

rfs:ClaimSubject a sh:NodeShape ;
    rdfs:comment "What a Claim is about: a place, plot, project, organization, community, indicator, dataset or another claim, identified by an IRI so that claims about the same subject can be joined. The IRI identifies the subject itself; its full description lives on its own resource." ;
    sh:closed true ;
    sh:ignoredProperties ( rfs:baselineYear rfs:siteKey rfs:parcelId rfs:project rfs:registryProjectId rfs:site rfs:plotKey rfs:cohort rdf:type schema1:addressCountry ) ;
    sh:property [ sh:description "IRI or CURIE of the subject, for example https://example.org/plot/A." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rfs:id ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name of the subject." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:ClaimSubject .

geo:Feature a sh:NodeShape ;
    rdfs:comment "A spatial feature, such as a project or area, with a defined geometry and optional bounding box." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class geo:Geometry ;
            sh:description "A derived geometry representing the bounding box of the geometry or feature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path geo:hasBoundingBox ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class geo:Geometry ;
            sh:description "A derived geometry representing the centroid of the feature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path geo:hasCentroid ],
        [ sh:class geo:Geometry ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path geo:hasGeometry ] ;
    sh:targetClass geo:Feature .

rfs:DatePeriod a sh:NodeShape ;
    rdfs:comment "A period between two dates, both included." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "Last day of the period, included." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:endDate ],
        [ sh:datatype xsd:date ;
            sh:description "First day of the period, included." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:startDate ] ;
    sh:targetClass rfs:DatePeriod .

rfs:Link a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( schema1:version rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:description ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:Link .

rfs:ReferenceId a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An optional label that describes the identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:referenceType ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier value" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:identifier ] ;
    sh:targetClass rfs:ReferenceId .

qudt:QuantityValue a sh:NodeShape ;
    rdfs:comment "A value that represents a quantity, with a numeric value and the unit it is expressed in, as a QUDT quantity value." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "IRI of the unit in the QUDT unit vocabulary (http://qudt.org/vocab/unit/), for example unit:HA (hectare)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path qudt:hasUnit ],
        [ sh:datatype xsd:float ;
            sh:description "The numeric value of the quantity. It cannot be negative: the quantities stated so far are sizes and areas." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path qudt:value ] ;
    sh:targetClass qudt:QuantityValue .

rfs:Methodology a sh:NodeShape ;
    rdfs:comment "Details about a specific methodology." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version number of the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:version ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:Methodology .

rfs:Evidence a sh:NodeShape ;
    rdfs:comment "A source cited as evidence: a document, dataset, record or observation, identified by an IRI. The IRI names the exact version cited and may carry a fragment for a position inside it, for example a page. Whether it actually supports a claim is judged separately, by attestations, and its current availability or access is not recorded here." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Genre of the cited source, from the DCMI Type Vocabulary, which the dcterms:type definition recommends. Finer kinds of evidence that a program accepts, such as a lease agreement, belong to that program's rule set, not to Evidence." ;
            sh:in ( dcmitype:Collection dcmitype:Dataset dcmitype:Event dcmitype:Image dcmitype:InteractiveResource dcmitype:MovingImage dcmitype:PhysicalObject dcmitype:Service dcmitype:Software dcmitype:Sound dcmitype:StillImage dcmitype:Text ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path dcterms:type ],
        [ sh:datatype xsd:string ;
            sh:description "What the source is, in the citer's words." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:description "IRI or CURIE of the exact source version cited, for example https://example.org/project-plan-v2.pdf#page=12." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rfs:id ],
        [ sh:description "IRI of the licence document or versioned licence terms in effect for this version of the source. When absent, the terms must be read as \"unspecified — all rights reserved\" (rfs:UnspecifiedAllRightsReserved), never as unrestricted." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dcterms:license ],
        [ sh:datatype xsd:string ;
            sh:description "Media type of the source, for example application/pdf." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:format ],
        [ sh:class rfs:Activity ;
            sh:description "The activity that produced the cited source, with its period and who carried it out: for example the soil sampling behind a results file, or the field operations a farm management record documents. When the evidence was produced is the activity's period, not a field of Evidence, because PROV-O declares activities and entities disjoint. Evidence produced by the same activity names the same activity IRI." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "Where the bytes of the cited version can be fetched. The data can stay where its owner keeps it; the claim stores only the hash and the resolver. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rfs:resolver ],
        [ sh:datatype xsd:string ;
            sh:description "Title of the cited source." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:date ;
            sh:description "Date of the cited version of the source." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:issued ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable position inside the source, for example \"section 1.9, Table 2\", when the IRI fragment is not enough." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path rfs:locator ],
        [ sh:class rfs:ContentDigest ;
            sh:description "Hash of the bytes of the cited source version. This is the hash of the source, which a citation needs; it is not the hash of the Claim or Attestation that cites it, which is never part of its own content." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path rfs:contentHash ] ;
    sh:targetClass rfs:Evidence .

rfs:Impact a sh:NodeShape ;
    rdfs:comment "Represents an ecological, social, or broader impact or benefit usually in the context of a project's activities. Impacts can be measurable or qualitative." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name is optional and will be inferred from the ImpactType if not provided." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:description "Type of impact, such as ecological, social, or economic." ;
            sh:in ( rft:ReducedFertilizerAmendments rft:AvoidedDeforestationDegradation rft:ImprovedCulturalHeritageAwareness rft:ImprovedBiodiversity rft:ImprovedEnvironmentalEducationOutreach rft:ReducedSoilErosion rft:ReducedHerbicideAmendments rft:ImprovedForestHealth rft:ImprovedCommunityHealth rft:ImprovedWildlifeHabitat rft:ImprovedSoilHealth rft:IncreasedForestCover rft:ReducedPesticideAmendments rft:ImprovedWaterInfiltration rft:ImprovedWaterHoldingCapacity rft:IncreasedCarbonSequestrationStorage rft:ReducedIrrigation rft:ImprovedSoilStructure rft:ImprovedNutrientCycling "UNKNOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path rfs:hasImpactType ],
        [ sh:description "List of relevant Sustainable Development Goals that this impact supports." ;
            sh:in ( sdgs:goal1 sdgs:goal2 sdgs:goal3 sdgs:goal4 sdgs:goal5 sdgs:goal6 sdgs:goal7 sdgs:goal8 sdgs:goal9 sdgs:goal10 sdgs:goal11 sdgs:goal12 sdgs:goal13 sdgs:goal14 sdgs:goal15 sdgs:goal16 sdgs:goal17 ) ;
            sh:order 2 ;
            sh:path rfs:supportsSDG ] ;
    sh:targetClass rfs:Impact .

rfs:Entity a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:in ( rfs:Individual rfs:Organization rfs:Community ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path rfs:type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:image ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "On-chain wallet address (bech32 or hex) bridging semantic identity to signing capability. Used by the identity bridge to link KOI entity URIs to on-chain accounts for CLAMS and EAS interop." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rfs:walletAddress ] ;
    sh:targetClass rfs:Entity .


rfs:Entity rdfs:subClassOf prov:Agent .

rfs:Evidence rdfs:subClassOf prov:Entity .

rfs:EvidenceEvaluation rdfs:subClassOf rfs:Evaluation .

rfs:GenericClaim rdfs:subClassOf rfs:Claim .


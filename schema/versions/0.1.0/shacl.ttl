rfs:RegistryRequirementEvaluation a sh:NodeShape ;
    rdfs:comment "The evaluator's finding, as of its date, on whether a project meets one exact requirement version. It states whether the requirement applies and, when it does, whether it is satisfied. Each requirement judged is its own evaluation, so every requirement has its own applicability and outcome. A satisfied requirement is not an approval of the project's registration, which is an institutional decision." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "What an evaluation judges or answers: the identifier of an exact, immutable version of a claim, of another evaluation, or of a snapshot (a fixed set of claim versions), or, for an evidence evaluation, of the Evidence records it assesses. Never a logical identifier or label. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path rfs:hasTarget ],
        [ sh:description "Whether the applied requirement is satisfied, as of this record's date. A sub-property of outcome." ;
            sh:in ( rfs:Satisfied rfs:NotSatisfied rfs:Undetermined ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path rfs:requirementOutcome ],
        [ sh:datatype xsd:boolean ;
            sh:description "True when the issuer explicitly gives the judgment no limits beyond what it targets, so that an unlimited approval is a stated choice rather than an omission. Stated only on an evaluation without a scope: the two are exclusive." ;
            sh:maxCount 1 ;

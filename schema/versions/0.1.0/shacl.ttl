            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:class geo:Geometry ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path geo:hasGeometry ] ;
    sh:targetClass rfs:File .

rfs:ManagementArea a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "the activity" ;
            sh:in ( rft:ResidueTillageManagement rft:BiocharProduction rft:ImprovedForestManagement rft:Agroforestry rft:PrescribedGrazing rft:RiparianForestBuffers rft:SoilAmendments rft:Conservation rft:Ecotourism rft:CoverCropping rft:TreePlanting rft:PhotocatalystApplication rft:EcosystemRestoration rft:IndustrialBiocharProduction rft:ArtisanalBiocharProduction rft:Biochar rft:EnhancedRockWeathering rft:CompostAmendments rft:KeystoneSpeciesConservation rft:UmbrellaSpeciesConservation rft:Silvopasture rft:ForestFarming rft:NonUrbanForestImprovement rft:UrbanForestImprovement rft:Afforestation rft:Reforestation ) ;
            sh:order 0 ;
            sh:path rfs:projectActivity ],

            sh:order 0 ;
            sh:path rfs:area ] ;
    sh:targetClass rfs:C06PlotClaim .

rfs:C06ProjectClaim a sh:NodeShape ;
    rdfs:comment "The project developer's assertions about the whole project: the rule sets and methodologies it applies, that it is an aggregate project, its start and adoption dates, crediting and permanence periods, and the deviations it requests. Its structured fields are optional: a claim that only states something the project plan says, such as how local stakeholders were consulted, carries its claimStatement alone, with the plan section as evidence." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "True when the project is an aggregate project: a group of sites, each individually identifiable, registered as one project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rfs:isAggregateProject ],
        [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path schema1:url ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the claimant presents as evidence for the assertion, each the IRI of an Evidence record for the exact version cited. The record is its own document, described once and never inlined. Where inside a source the cited material is goes in hasEvidenceCitation. Whether a source actually supports the assertion is judged separately, by evaluations. Specializes dcterms:references. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path rfs:hasEvidence ],
        [ sh:description "Identifier of an exact version of a normative rule set applied, such as a credit class, a methodology or a program guide version. It is content and enters the identity of the record. It is distinct from a schema-version declaration, which states which schema the RDF conforms to. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rfs:appliesRuleSet ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion, as the claimants state it in natural language. It is asserted content, not a presentational summary: changing it changes the Claim. A claim type may also formalize the assertion, or add detail to it, in structured fields; the statement and those fields are one assertion and must agree. When they disagree, neither overrides the other: the Claim is internally inconsistent and is corrected by a new version before its evidence is evaluated. Specializes schema:description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path rfs:claimStatement ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises: its ClaimIRI. A Claim has no identifier slot, because its ClaimIRI is computed over its canonical form outside Claim content (regen-network/claims#1), so the value is a bare IRI and the slot names no class. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its evaluations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path prov:wasRevisionOf ],
        [ sh:datatype xsd:string ;
            sh:description "The event or record that establishes the start date, for example the first baseline soil sampling or a contract signature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path rfs:startDateBasis ],
        [ sh:datatype xsd:date ;
            sh:description "When the project activities were adopted." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rfs:adoptionDate ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the claimants made this assertion. For an assertion they made in a source document, such as a project plan, and that was transcribed later, it is when they made it there, not when it was extracted, transcribed or submitted. It is never the time of an observation, or the time the Claim record was generated, submitted, published or ingested. The same content asserted at a different time is a different Claim. Written in UTC with whole seconds and the offset +00:00, for example 2026-05-02T07:30:00+00:00. No other offset is accepted, and neither is the Z suffix." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$" ],
        [ sh:datatype xsd:string ;
            sh:description "Language of claimStatement, as a BCP 47 tag with a 2- or 3-letter ISO 639 primary language subtag, such as en or cs. It says nothing about the language of the cited sources, which they record themselves, or about how a statement translated from a source was derived." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:inLanguage ;
            sh:pattern "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$" ],
        [ sh:datatype xsd:date ;
            sh:description "Start date of the aggregate project. Each site also has its own start date (siteProjectStartDate)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rfs:aggregateStartDate ],
        [ sh:class rfs:DatePeriod ;
            sh:description "The period during which credits can be issued for the subject. In an aggregate project, cohorts and sites may have their own." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path rfs:creditingPeriod ],
        [ sh:class rfs:Entity ;
            sh:description "The agent or agents that take responsibility for asserting this exact content: an individual, organization or community. Each listed claimant takes responsibility for the whole assertion. Taking that responsibility is distinct from writing, extracting, generating, transforming or submitting the content: a person, tool or service that only did that is not a claimant unless it takes responsibility for the assertion itself. A collective that asserts as one body is a single claimant of type COMMUNITY or ORGANIZATION; listing it does not make its members co-claimants. The capacity in which a claimant acts, such as project proponent or verifier, is a role in the context of the claim, not a kind of agent. Listing a claimant records who takes responsibility; it does not by itself establish that the claimant is authorized to assert on behalf of a project, community, program or other party. Specializes prov:wasAttributedTo, so under PROV each claimant is an agent associated with the activity that generated the Claim, which is the act of asserting. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path rfs:assertedBy ],
        [ sh:class rfs:MethodologyUse ;
            sh:description "The methodology versions the project applies, each with its role and what it is used for. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path rfs:methodologyUse ],
        [ sh:class rfs:EvidenceCitation ;
            sh:description "Where inside cited sources the material the assertion relies on is: citations, each with one source listed in hasEvidence and the selectors that locate the material. A source cited as a whole needs no citation. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path rfs:hasEvidenceCitation ],
        [ sh:class rfs:Project ;
            sh:description "The one focal resource the claim is about, as a ClaimSubject node identified by its IRI: a place, plot, project, organization, community, indicator, dataset or another claim. It is not every participant the assertion mentions: in a claim relating several parties, the others appear in named roles defined by the claim-type schema, or the relationship or activity itself is the subject. Claims about the same subject share its IRI and can be joined. Specialized claim schemas narrow the range to a subclass of ClaimSubject. Not the claimant, and not necessarily the feature of interest of an observation inside the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path rfs:hasSubject ],
        [ sh:class rfs:DeviationRequest ;
            sh:description "Project-specific deviations from requirements that the project developer requests in its project plan, each naming the requirements it replaces. Whether a deviation is approved is a separate evaluation. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:requestedDeviations ],
        [ sh:datatype xsd:string ;
            sh:description "Optional human-readable title of the claim, for display. It is not the assertion, which is claimStatement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:name ],
        [ sh:class rfs:DatePeriod ;
            sh:description "The period after the crediting period during which the carbon stored must be maintained." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path rfs:permanencePeriod ] ;
    sh:targetClass rfs:C06ProjectClaim .

rfs:C06SiteClaim a sh:NodeShape ;
    rdfs:comment "The project developer's assertions about one site: its start date and crediting period, ecosystem types, climate and soil classes, practices, primary land use and soil monitoring schedule. Records of its historic activity are cited as evidence." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class rfs:Evidence ;
            sh:description "Sources the claimant presents as evidence for the assertion, each the IRI of an Evidence record for the exact version cited. The record is its own document, described once and never inlined. Where inside a source the cited material is goes in hasEvidenceCitation. Whether a source actually supports the assertion is judged separately, by evaluations. Specializes dcterms:references. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path rfs:hasEvidence ],
        [ sh:description "Ecosystem types of the site, as taxonomy terms such as cropland or pastureland. Unordered set." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:order 3 ;
            sh:path rfs:ecosystemTypes ],
        [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "World Reference Base soil group, for example Cambisol." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rfs:soilGroup ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises: its ClaimIRI. A Claim has no identifier slot, because its ClaimIRI is computed over its canonical form outside Claim content (regen-network/claims#1), so the value is a bare IRI and the slot names no class. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its evaluations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path prov:wasRevisionOf ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion, as the claimants state it in natural language. It is asserted content, not a presentational summary: changing it changes the Claim. A claim type may also formalize the assertion, or add detail to it, in structured fields; the statement and those fields are one assertion and must agree. When they disagree, neither overrides the other: the Claim is internally inconsistent and is corrected by a new version before its evidence is evaluated. Specializes schema:description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path rfs:claimStatement ],
        [ sh:datatype xsd:date ;
            sh:description "Dates of soil sampling at the site." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path rfs:monitoringSampleDates ],
        [ sh:datatype xsd:string ;
            sh:description "The event or record that establishes the start date, for example the first baseline soil sampling or a contract signature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:startDateBasis ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the claimants made this assertion. For an assertion they made in a source document, such as a project plan, and that was transcribed later, it is when they made it there, not when it was extracted, transcribed or submitted. It is never the time of an observation, or the time the Claim record was generated, submitted, published or ingested. The same content asserted at a different time is a different Claim. Written in UTC with whole seconds and the offset +00:00, for example 2026-05-02T07:30:00+00:00. No other offset is accepted, and neither is the Z suffix." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$" ],
        [ sh:description "The site's primary land use, as a taxonomy term, which the site must maintain during its project period." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path rfs:primaryLandUse ],
        [ sh:class rfs:DatePeriod ;
            sh:description "The period during which credits can be issued for the subject. In an aggregate project, cohorts and sites may have their own." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path rfs:creditingPeriod ],
        [ sh:class rfs:Entity ;
            sh:description "The agent or agents that take responsibility for asserting this exact content: an individual, organization or community. Each listed claimant takes responsibility for the whole assertion. Taking that responsibility is distinct from writing, extracting, generating, transforming or submitting the content: a person, tool or service that only did that is not a claimant unless it takes responsibility for the assertion itself. A collective that asserts as one body is a single claimant of type COMMUNITY or ORGANIZATION; listing it does not make its members co-claimants. The capacity in which a claimant acts, such as project proponent or verifier, is a role in the context of the claim, not a kind of agent. Listing a claimant records who takes responsibility; it does not by itself establish that the claimant is authorized to assert on behalf of a project, community, program or other party. Specializes prov:wasAttributedTo, so under PROV each claimant is an agent associated with the activity that generated the Claim, which is the act of asserting. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path rfs:assertedBy ],
        [ sh:description "Practices implemented on the site." ;
            sh:in ( rft:ResidueTillageManagement rft:BiocharProduction rft:ImprovedForestManagement rft:Agroforestry rft:PrescribedGrazing rft:RiparianForestBuffers rft:SoilAmendments rft:Conservation rft:Ecotourism rft:CoverCropping rft:TreePlanting rft:PhotocatalystApplication rft:EcosystemRestoration rft:IndustrialBiocharProduction rft:ArtisanalBiocharProduction rft:Biochar rft:EnhancedRockWeathering rft:CompostAmendments rft:KeystoneSpeciesConservation rft:UmbrellaSpeciesConservation rft:Silvopasture rft:ForestFarming rft:NonUrbanForestImprovement rft:UrbanForestImprovement rft:Afforestation rft:Reforestation ) ;
            sh:order 6 ;
            sh:path rfs:practices ],
        [ sh:datatype xsd:string ;
            sh:description "Why sampling intervals differ from the expected cadence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path rfs:monitoringIntervalJustification ],
        [ sh:datatype xsd:date ;
            sh:description "The site's own project start date. In an aggregate project each site defines its own, which may differ from the aggregate's; its basis is stated in startDateBasis." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:siteProjectStartDate ],
        [ sh:datatype xsd:string ;
            sh:description "Language of claimStatement, as a BCP 47 tag with a 2- or 3-letter ISO 639 primary language subtag, such as en or cs. It says nothing about the language of the cited sources, which they record themselves, or about how a statement translated from a source was derived." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path schema1:inLanguage ;
            sh:pattern "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$" ],
        [ sh:datatype xsd:string ;
            sh:description "Köppen-Geiger climate class, for example Dfb." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path rfs:climateClass ],
        [ sh:datatype xsd:string ;
            sh:description "Optional human-readable title of the claim, for display. It is not the assertion, which is claimStatement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema1:name ],
        [ sh:class rfs:EvidenceCitation ;
            sh:description "Where inside cited sources the material the assertion relies on is: citations, each with one source listed in hasEvidence and the selectors that locate the material. A source cited as a whole needs no citation. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path rfs:hasEvidenceCitation ],
        [ sh:class rfs:Site ;
            sh:description "The one focal resource the claim is about, as a ClaimSubject node identified by its IRI: a place, plot, project, organization, community, indicator, dataset or another claim. It is not every participant the assertion mentions: in a claim relating several parties, the others appear in named roles defined by the claim-type schema, or the relationship or activity itself is the subject. Claims about the same subject share its IRI and can be joined. Specialized claim schemas narrow the range to a subclass of ClaimSubject. Not the claimant, and not necessarily the feature of interest of an observation inside the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path rfs:hasSubject ] ;
    sh:targetClass rfs:C06SiteClaim .

rfs:CarbonCreditClassInfo a sh:NodeShape ;
    rdfs:comment "Off-chain metadata representation for credit classes where the credit type is Carbon (C)" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:duration ;
            sh:description "The total duration of the crediting term for the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path rfs:hasCreditingPeriod ],
        [ sh:description "Types of environments that a project registered under this credit class may focuses on." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:minCount 1 ;
            sh:order 12 ;
            sh:path rfs:eligibleEnvironmentTypes ],
        [ sh:description "Method for generating credits." ;
            sh:in ( "AVOIDED_EMISSIONS" "CARBON_DIOXIDE_REMOVAL" "EMISSIONS_REDUCTION" ) ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path rfs:hasCreditGenerationMethod ],
        [ sh:class rfs:Methodology ;
            sh:description "If one or more standalone methodologies for quantifying GHG or other benefits are approved for use, supplemental to any explicit methodlogies defined within the main creditProtocol document, they can be listed here." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path rfs:hasApprovedMethodologies ],
        [ sh:datatype xsd:duration ;
            sh:description "Permanence period of the credits." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:hasPermanencePeriod ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:description ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path schema1:url ],
        [ sh:description "Eligible activities for projects registered under this credit class." ;
            sh:in ( rft:ResidueTillageManagement rft:BiocharProduction rft:ImprovedForestManagement rft:Agroforestry rft:PrescribedGrazing rft:RiparianForestBuffers rft:SoilAmendments rft:Conservation rft:Ecotourism rft:CoverCropping rft:TreePlanting rft:PhotocatalystApplication rft:EcosystemRestoration rft:IndustrialBiocharProduction rft:ArtisanalBiocharProduction rft:Biochar rft:EnhancedRockWeathering rft:CompostAmendments rft:KeystoneSpeciesConservation rft:UmbrellaSpeciesConservation rft:Silvopasture rft:ForestFarming rft:NonUrbanForestImprovement rft:UrbanForestImprovement rft:Afforestation rft:Reforestation ) ;
            sh:minCount 1 ;
            sh:order 13 ;
            sh:path rfs:eligibleActivities ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:name ],
        [ sh:class rfs:CreditingProgram ;
            sh:description "The higher-level rules and requirements under which the given credit protocol operates, sometimes referred to as the \"Standard\"." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:managedUnderProgram ],
        [ sh:class rfs:CreditProtocol ;
            sh:description "The root document of the credit protocol that defines the requirements and process to register and issue credits under a credit protocol. It could be registered under a program or independent. It could include methods to measure and monitor, or reference other methodology documents." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path rfs:hasCreditProtocol ],
        [ sh:class rfs:Impact ;
            sh:description "Co-benefits are any secondary impacts that may result from adhering to the protocol and/or management practices associated with the credit class. They can be qualitative or quantitative." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path rfs:hasCoBenefits ],
        [ sh:class rfs:Registry ;
            sh:description "The registry where the credits are originally issued and tracked if somewhere other than Regen Network." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path rfs:hasSourceRegistry ],
        [ sh:class rfs:BufferPoolAccount ;
            sh:description "Buffer pool accounts associated with the credit class." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path rfs:hasBufferPoolAccounts ],
        [ sh:class rfs:Impact ;
            sh:description "The primary impact expected from adhering to the protocol and/or management practices associated with the credit class. Generally speaking the quantifiable components of this impact are associated with the credit type that the credit class exists under (e.g. Carbon, Biodiversity, etc)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path rfs:hasPrimaryImpact ] ;
    sh:targetClass rfs:CarbonCreditClassInfo .

rfs:Claim a sh:NodeShape ;
    rdfs:comment "An assertion made or adopted by one or more claimants about one subject, at a stated time. It records what is asserted and may cite evidence. A Claim is one unit that can be accepted, rejected, evidenced or revised on its own, and one unit of responsibility: each claimant takes responsibility for all of it. It may span many RDF statements; parts that a reviewer could judge separately, or that different agents take responsibility for, are separate Claims. A Claim is asserted by definition, so it is self-attested by its claimants and is valid without any third-party evaluation; later reviews are separate resources that point to it. An unasserted authoring candidate, such as an extraction draft without a claimant, is not a Claim. Every version is immutable: a correction is a new Claim that states wasRevisionOf. Abstract: a document is typed with a claim type, either GenericClaim or a class from a claim-type schema. The constraints here apply to every claim type, and a claim type may add fields to them, so the generated SHACL shape for Claim is open; each claim type's own shape is closed." ;
    sh:closed false ;
    sh:ignoredProperties ( rfs:permanencePeriod rfs:issuerRole rfs:outcome rfs:hasTarget rfs:rationale rfs:verificationMethodDescriptor rfs:creditingPeriod rfs:startDateBasis rfs:primaryLandUse rfs:climateClass rdf:type rfs:siteProjectStartDate rfs:adoptionDate rfs:unbounded rfs:findingState rfs:soilGroup rfs:applicability rfs:findingLabel rfs:practices rfs:ecosystemTypes rfs:monitoringIntervalJustification rfs:conditions rfs:aggregateStartDate rfs:requirementOutcome rfs:area rfs:evidenceSufficiency rfs:verificationMethod rfs:convertedFromNaturalEcosystem rfs:assessedAgainst rfs:methodologyUse rfs:appliesRuleSet rfs:scope rfs:claimConsistency rfs:tenureBasis rfs:requestedDeviations rfs:geometry rfs:reportRating rfs:findingType rfs:appliesRequirement rfs:reliesOn rfs:evidentialStance rfs:isAggregateProject rfs:monitoringSampleDates ) ;
    sh:property [ sh:class rfs:Evidence ;
            sh:description "Sources the claimant presents as evidence for the assertion, each the IRI of an Evidence record for the exact version cited. The record is its own document, described once and never inlined. Where inside a source the cited material is goes in hasEvidenceCitation. Whether a source actually supports the assertion is judged separately, by evaluations. Specializes dcterms:references. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path rfs:hasEvidence ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises: its ClaimIRI. A Claim has no identifier slot, because its ClaimIRI is computed over its canonical form outside Claim content (regen-network/claims#1), so the value is a bare IRI and the slot names no class. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its evaluations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasRevisionOf ],
        [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion, as the claimants state it in natural language. It is asserted content, not a presentational summary: changing it changes the Claim. A claim type may also formalize the assertion, or add detail to it, in structured fields; the statement and those fields are one assertion and must agree. When they disagree, neither overrides the other: the Claim is internally inconsistent and is corrected by a new version before its evidence is evaluated. Specializes schema:description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:claimStatement ],
        [ sh:datatype xsd:string ;
            sh:description "Language of claimStatement, as a BCP 47 tag with a 2- or 3-letter ISO 639 primary language subtag, such as en or cs. It says nothing about the language of the cited sources, which they record themselves, or about how a statement translated from a source was derived." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:inLanguage ;
            sh:pattern "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$" ],
        [ sh:class rfs:Entity ;
            sh:description "The agent or agents that take responsibility for asserting this exact content: an individual, organization or community. Each listed claimant takes responsibility for the whole assertion. Taking that responsibility is distinct from writing, extracting, generating, transforming or submitting the content: a person, tool or service that only did that is not a claimant unless it takes responsibility for the assertion itself. A collective that asserts as one body is a single claimant of type COMMUNITY or ORGANIZATION; listing it does not make its members co-claimants. The capacity in which a claimant acts, such as project proponent or verifier, is a role in the context of the claim, not a kind of agent. Listing a claimant records who takes responsibility; it does not by itself establish that the claimant is authorized to assert on behalf of a project, community, program or other party. Specializes prov:wasAttributedTo, so under PROV each claimant is an agent associated with the activity that generated the Claim, which is the act of asserting. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path rfs:assertedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the claimants made this assertion. For an assertion they made in a source document, such as a project plan, and that was transcribed later, it is when they made it there, not when it was extracted, transcribed or submitted. It is never the time of an observation, or the time the Claim record was generated, submitted, published or ingested. The same content asserted at a different time is a different Claim. Written in UTC with whole seconds and the offset +00:00, for example 2026-05-02T07:30:00+00:00. No other offset is accepted, and neither is the Z suffix." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$" ],
        [ sh:datatype xsd:string ;
            sh:description "Optional human-readable title of the claim, for display. It is not the assertion, which is claimStatement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class rfs:EvidenceCitation ;
            sh:description "Where inside cited sources the material the assertion relies on is: citations, each with one source listed in hasEvidence and the selectors that locate the material. A source cited as a whole needs no citation. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:hasEvidenceCitation ],
        [ sh:class rfs:ClaimSubject ;
            sh:description "The one focal resource the claim is about, as a ClaimSubject node identified by its IRI: a place, plot, project, organization, community, indicator, dataset or another claim. It is not every participant the assertion mentions: in a claim relating several parties, the others appear in named roles defined by the claim-type schema, or the relationship or activity itself is the subject. Claims about the same subject share its IRI and can be joined. Specialized claim schemas narrow the range to a subclass of ClaimSubject. Not the claimant, and not necessarily the feature of interest of an observation inside the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path rfs:hasSubject ] ;
    sh:targetClass rfs:Claim .

rfs:ClaimConsistencyEvaluation a sh:NodeShape ;
    rdfs:comment "Whether a claim's statement and its structured fields express the same assertion. The generated validators check structure only; they cannot compare prose with values, so a reviewer records the result on the exact claim version. An internally inconsistent claim is corrected by a new version before its evidence is evaluated; neither the statement nor the fields override the other." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Whether the claim's statement and structured fields agree. A sub-property of outcome." ;
            sh:in ( rfs:Consistent rfs:InternallyInconsistent ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path rfs:claimConsistency ],
        [ sh:description "Identifier of an exact version of a normative rule set applied, such as a credit class, a methodology or a program guide version. It is content and enters the identity of the record. It is distinct from a schema-version declaration, which states which schema the RDF conforms to. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path rfs:appliesRuleSet ],
        [ sh:description "Exact versions of claims or evaluations that a judgment depends on without judging them, for example the claim stating an enrolment cutoff that an approval relies on. Each value is the identifier of one immutable version. Specializes dcterms:references, so it asserts neither derivation nor support. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rfs:reliesOn ],
        [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path schema1:url ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises: its ClaimIRI. A Claim has no identifier slot, because its ClaimIRI is computed over its canonical form outside Claim content (regen-network/claims#1), so the value is a bare IRI and the slot names no class. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its evaluations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path prov:wasRevisionOf ],
        [ sh:class rfs:Entity ;
            sh:description "The issuer: the party that makes the judgment and takes responsibility for it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path rfs:assertedBy ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion, as the claimants state it in natural language. It is asserted content, not a presentational summary: changing it changes the Claim. A claim type may also formalize the assertion, or add detail to it, in structured fields; the statement and those fields are one assertion and must agree. When they disagree, neither overrides the other: the Claim is internally inconsistent and is corrected by a new version before its evidence is evaluated. Specializes schema:description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path rfs:claimStatement ],
        [ sh:datatype xsd:boolean ;
            sh:description "True when the issuer explicitly gives the judgment no limits beyond what it targets, so that an unlimited approval is a stated choice rather than an omission. Stated only on an evaluation without a scope: the two are exclusive." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path rfs:unbounded ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the issuer relied on." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path rfs:hasEvidence ],
        [ sh:description "The exact claim versions whose statement and fields are compared. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rfs:hasTarget ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the issuer made the judgment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$" ],
        [ sh:datatype xsd:string ;
            sh:description "Where the statement and the fields agree or disagree, for example \"the statement gives 12 ha, the area field 15 ha\"." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rfs:rationale ],
        [ sh:description "How the assertion or judgment was established, as structured data, so that a consumer can distinguish, for example, a lab-measured value from a self-attested one. One method per record: its party and date are those of the record that carries it (for an evaluation, its issuer and assertedAt), so a subject checked by two methods has two records, each with its own party and date. A value of OTHER must come with verificationMethodDescriptor." ;
            sh:in ( rfs:SelfAttested rfs:PeerOrCommunity rfs:LabMeasured rfs:SensorDerived rfs:ModelEstimated rfs:ThirdPartyAudited rfs:OtherVerificationMethod ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path rfs:verificationMethod ],
        [ sh:datatype xsd:string ;
            sh:description "Language of claimStatement, as a BCP 47 tag with a 2- or 3-letter ISO 639 primary language subtag, such as en or cs. It says nothing about the language of the cited sources, which they record themselves, or about how a statement translated from a source was derived." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path schema1:inLanguage ;
            sh:pattern "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$" ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of a verification method that the VerificationMethodType enumeration does not cover; required when verificationMethod is OTHER. It must contain a non-whitespace character, so an empty descriptor cannot leave the method unspecified. It is the extension path: a method that recurs is added to the enumeration in a later schema version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path rfs:verificationMethodDescriptor ;
            sh:pattern "\\S" ],
        [ sh:datatype xsd:string ;
            sh:description "Optional human-readable title of the claim, for display. It is not the assertion, which is claimStatement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema1:name ],
        [ sh:description "Exact requirement versions an evaluation applies or judges, whether or not the claimant named them. Each identifier names one immutable requirement version within an exact rule-set version, such as a checklist version: the same short ID can name different requirements in different versions. The rule-set and requirement records themselves are defined by WP5-01 (claims#30). Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rfs:appliesRequirement ],
        [ sh:class rfs:ClaimSubject ;
            sh:description "What the judgment is about: a project, plot or other subject. It is stated even when it is also the subject of a targeted claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path rfs:hasSubject ],
        [ sh:class rfs:Scope ;
            sh:description "Where the judgment applies: the subjects it covers, what it explicitly excludes, and what it does not establish." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:scope ],
        [ sh:class rfs:EvidenceCitation ;
            sh:description "Where inside cited sources the material the assertion relies on is: citations, each with one source listed in hasEvidence and the selectors that locate the material. A source cited as a whole needs no citation. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path rfs:hasEvidenceCitation ] ;
    sh:targetClass rfs:ClaimConsistencyEvaluation .

rfs:CreditClassInfo a sh:NodeShape ;
    rdfs:comment "Base class with common fields used to define credit class info." ;
    sh:closed true ;
    sh:ignoredProperties ( rfs:hasPermanencePeriod rdf:type rfs:hasCreditGenerationMethod ) ;
    sh:property [ sh:description "Types of environments that a project registered under this credit class may focuses on." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:minCount 1 ;
            sh:order 10 ;
            sh:path rfs:eligibleEnvironmentTypes ],
        [ sh:description "Eligible activities for projects registered under this credit class." ;
            sh:in ( rft:ResidueTillageManagement rft:BiocharProduction rft:ImprovedForestManagement rft:Agroforestry rft:PrescribedGrazing rft:RiparianForestBuffers rft:SoilAmendments rft:Conservation rft:Ecotourism rft:CoverCropping rft:TreePlanting rft:PhotocatalystApplication rft:EcosystemRestoration rft:IndustrialBiocharProduction rft:ArtisanalBiocharProduction rft:Biochar rft:EnhancedRockWeathering rft:CompostAmendments rft:KeystoneSpeciesConservation rft:UmbrellaSpeciesConservation rft:Silvopasture rft:ForestFarming rft:NonUrbanForestImprovement rft:UrbanForestImprovement rft:Afforestation rft:Reforestation ) ;
            sh:minCount 1 ;
            sh:order 11 ;
            sh:path rfs:eligibleActivities ],
        [ sh:datatype xsd:duration ;
            sh:description "The total duration of the crediting term for the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path rfs:hasCreditingPeriod ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path schema1:url ],
        [ sh:class rfs:CreditingProgram ;
            sh:description "The higher-level rules and requirements under which the given credit protocol operates, sometimes referred to as the \"Standard\"." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path rfs:managedUnderProgram ],
        [ sh:class rfs:CreditProtocol ;
            sh:description "The root document of the credit protocol that defines the requirements and process to register and issue credits under a credit protocol. It could be registered under a program or independent. It could include methods to measure and monitor, or reference other methodology documents." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path rfs:hasCreditProtocol ],
        [ sh:class rfs:Impact ;
            sh:description "Co-benefits are any secondary impacts that may result from adhering to the protocol and/or management practices associated with the credit class. They can be qualitative or quantitative." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path rfs:hasCoBenefits ],
        [ sh:class rfs:Methodology ;
            sh:description "If one or more standalone methodologies for quantifying GHG or other benefits are approved for use, supplemental to any explicit methodlogies defined within the main creditProtocol document, they can be listed here." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:hasApprovedMethodologies ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class rfs:BufferPoolAccount ;
            sh:description "Buffer pool accounts associated with the credit class." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path rfs:hasBufferPoolAccounts ],
        [ sh:class rfs:Registry ;
            sh:description "The registry where the credits are originally issued and tracked if somewhere other than Regen Network." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path rfs:hasSourceRegistry ],
        [ sh:class rfs:Impact ;
            sh:description "The primary impact expected from adhering to the protocol and/or management practices associated with the credit class. Generally speaking the quantifiable components of this impact are associated with the credit type that the credit class exists under (e.g. Carbon, Biodiversity, etc)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path rfs:hasPrimaryImpact ] ;
    sh:targetClass rfs:CreditClassInfo .

rfs:CreditProjectInfo a sh:NodeShape ;
    rdfs:label "Credit Project Info" ;
    rdfs:comment "Base class with additional fields for projects that issue credits." ;
    sh:closed true ;
    sh:ignoredProperties ( rfs:hasAdministrativeArea rfs:ecologicalConnectivityIndex rfs:iucnConservationStatus rfs:projectDuration rfs:socialCulturalIndex rfs:hasManagementAreas rfs:hasEnvironmentalAuthority rdf:type ) ;
    sh:property [ sh:description "The type of market for the associated credits." ;
            sh:in ( rfs:ComplianceMarket rfs:VoluntaryMarket ) ;
            sh:order 2 ;
            sh:path rfs:marketType ],
        [ sh:description "The environment type of the project." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:order 12 ;
            sh:path rfs:environmentType ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "The type of biome associated with the project." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path rfs:biomeType ],
        [ sh:datatype xsd:string ;
            sh:description "The version of the credit class used for the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:creditClassVersion ],
        [ sh:class rfs:Entity ;
            sh:description "The organization that is a partner for the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path rfs:hasProjectPartner ],
        [ sh:datatype xsd:string ;
            sh:description "The bioregion associated with the project." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rfs:bioregion ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for monitoring the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path rfs:hasProjectMonitor ],
        [ sh:description "The types of activities being implemented in projects" ;
            sh:in ( rft:ResidueTillageManagement rft:BiocharProduction rft:ImprovedForestManagement rft:Agroforestry rft:PrescribedGrazing rft:RiparianForestBuffers rft:SoilAmendments rft:Conservation rft:Ecotourism rft:CoverCropping rft:TreePlanting rft:PhotocatalystApplication rft:EcosystemRestoration rft:IndustrialBiocharProduction rft:ArtisanalBiocharProduction rft:Biochar rft:EnhancedRockWeathering rft:CompostAmendments rft:KeystoneSpeciesConservation rft:UmbrellaSpeciesConservation rft:Silvopasture rft:ForestFarming rft:NonUrbanForestImprovement rft:UrbanForestImprovement rft:Afforestation rft:Reforestation ) ;
            sh:order 18 ;
            sh:path rfs:activity ],
        [ sh:class rfs:ReferenceId ;
            sh:description "External reference IDs associated with the project." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path rfs:hasReferenceId ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "The region associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path rfs:region ],
        [ sh:datatype xsd:string ;
            sh:description "The watershed associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path rfs:watershed ],
        [ sh:datatype xsd:string ;
            sh:description "The sub-watershed associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path rfs:subWatershed ],
        [ sh:class qudt:QuantityValue ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path rfs:projectSize ],
        [ sh:datatype xsd:string ;
            sh:description "The start date of the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path schema1:startDate ],
        [ sh:class rfs:Entity ;
            sh:description "The organization that owns the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 24 ;
            sh:path rfs:hasProjectOwner ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for owning the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path rfs:hasProjectVerifier ],
        [ sh:class rfs:Impact ;
            sh:description "Co-benefits are any secondary impacts that may result from adhering to the protocol and/or management practices associated with the credit class. They can be qualitative or quantitative." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path rfs:hasCoBenefits ],
        [ sh:datatype xsd:string ;
            sh:description "The end date of the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path schema1:endDate ],
        [ sh:class geo:Feature ;
            sh:description "The location of the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path rfs:hasFeature ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for operating the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path rfs:hasProjectOperator ],
        [ sh:class rfs:Methodology ;
            sh:description "The methodology that the project uses." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path rfs:usesMethodology ],
        [ sh:class rfs:Link ;
            sh:description "A list of links associated with the project." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:hasLinks ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:name ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for owning the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path rfs:hasProjectDeveloper ],
        [ sh:class rfs:Impact ;
            sh:description "The primary impact expected from adhering to the protocol and/or management practices associated with the credit class. Generally speaking the quantifiable components of this impact are associated with the credit type that the credit class exists under (e.g. Carbon, Biodiversity, etc)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path rfs:hasPrimaryImpact ] ;
    sh:targetClass rfs:CreditProjectInfo .

rfs:Evaluation a sh:NodeShape ;
    rdfs:comment "An issuer's judgment, made at a stated time, about what it targets: exact versions of claims, of other evaluations, or a snapshot of claims. As a Claim it is attributed (assertedBy names the issuer), immutable and revisable with wasRevisionOf; it is about a subject, such as a project or a plot, even when it judges a claim about that subject. It does not carry its own hash or IRI, anchoring state, or a status that changes after it is made: a later judgment is a new Evaluation. Abstract, like Claim: its generated shape is open, so it checks the base content of every kind of evaluation, including kinds another program defines, and lets a kind add fields. A judgment with no program vocabulary is a GenericEvaluation." ;
    sh:closed false ;
    sh:ignoredProperties ( rfs:requirementOutcome rfs:evidenceSufficiency rfs:findingState rfs:issuerRole rfs:assessedAgainst rfs:evidentialStance rfs:findingLabel rfs:applicability rfs:outcome rfs:reportRating rfs:findingType rfs:claimConsistency rdf:type rfs:conditions ) ;
    sh:property [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path schema1:url ],
        [ sh:description "What an evaluation judges or answers: the identifier of an exact, immutable version of a claim, of another evaluation, or of a snapshot (a fixed set of claim versions), or, for an evidence evaluation, of the Evidence records it assesses. Never a logical identifier or label. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rfs:hasTarget ],
        [ sh:datatype xsd:string ;
            sh:description "Why the issuer reached the outcome." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path rfs:rationale ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion, as the claimants state it in natural language. It is asserted content, not a presentational summary: changing it changes the Claim. A claim type may also formalize the assertion, or add detail to it, in structured fields; the statement and those fields are one assertion and must agree. When they disagree, neither overrides the other: the Claim is internally inconsistent and is corrected by a new version before its evidence is evaluated. Specializes schema:description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path rfs:claimStatement ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises: its ClaimIRI. A Claim has no identifier slot, because its ClaimIRI is computed over its canonical form outside Claim content (regen-network/claims#1), so the value is a bare IRI and the slot names no class. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its evaluations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path prov:wasRevisionOf ],
        [ sh:description "Exact requirement versions an evaluation applies or judges, whether or not the claimant named them. Each identifier names one immutable requirement version within an exact rule-set version, such as a checklist version: the same short ID can name different requirements in different versions. The rule-set and requirement records themselves are defined by WP5-01 (claims#30). Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rfs:appliesRequirement ],
        [ sh:datatype xsd:boolean ;
            sh:description "True when the issuer explicitly gives the judgment no limits beyond what it targets, so that an unlimited approval is a stated choice rather than an omission. Stated only on an evaluation without a scope: the two are exclusive." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path rfs:unbounded ],
        [ sh:description "Exact versions of claims or evaluations that a judgment depends on without judging them, for example the claim stating an enrolment cutoff that an approval relies on. Each value is the identifier of one immutable version. Specializes dcterms:references, so it asserts neither derivation nor support. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rfs:reliesOn ],
        [ sh:description "Identifier of an exact version of a normative rule set applied, such as a credit class, a methodology or a program guide version. It is content and enters the identity of the record. It is distinct from a schema-version declaration, which states which schema the RDF conforms to. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rfs:appliesRuleSet ],
        [ sh:class rfs:ClaimSubject ;
            sh:description "What the judgment is about: a project, plot or other subject. It is stated even when it is also the subject of a targeted claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path rfs:hasSubject ],
        [ sh:class rfs:Entity ;
            sh:description "The issuer: the party that makes the judgment and takes responsibility for it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path rfs:assertedBy ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the issuer relied on." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path rfs:hasEvidence ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the issuer made the judgment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$" ],
        [ sh:datatype xsd:string ;
            sh:description "Language of claimStatement, as a BCP 47 tag with a 2- or 3-letter ISO 639 primary language subtag, such as en or cs. It says nothing about the language of the cited sources, which they record themselves, or about how a statement translated from a source was derived." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:inLanguage ;
            sh:pattern "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$" ],
        [ sh:class rfs:Scope ;
            sh:description "Where the judgment applies: the subjects it covers, what it explicitly excludes, and what it does not establish." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path rfs:scope ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of a verification method that the VerificationMethodType enumeration does not cover; required when verificationMethod is OTHER. It must contain a non-whitespace character, so an empty descriptor cannot leave the method unspecified. It is the extension path: a method that recurs is added to the enumeration in a later schema version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path rfs:verificationMethodDescriptor ;
            sh:pattern "\\S" ],
        [ sh:description "How the assertion or judgment was established, as structured data, so that a consumer can distinguish, for example, a lab-measured value from a self-attested one. One method per record: its party and date are those of the record that carries it (for an evaluation, its issuer and assertedAt), so a subject checked by two methods has two records, each with its own party and date. A value of OTHER must come with verificationMethodDescriptor." ;
            sh:in ( rfs:SelfAttested rfs:PeerOrCommunity rfs:LabMeasured rfs:SensorDerived rfs:ModelEstimated rfs:ThirdPartyAudited rfs:OtherVerificationMethod ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path rfs:verificationMethod ],
        [ sh:class rfs:EvidenceCitation ;
            sh:description "Where inside cited sources the material the assertion relies on is: citations, each with one source listed in hasEvidence and the selectors that locate the material. A source cited as a whole needs no citation. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path rfs:hasEvidenceCitation ],
        [ sh:datatype xsd:string ;
            sh:description "Optional human-readable title of the claim, for display. It is not the assertion, which is claimStatement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:Evaluation .

rfs:EvidenceEvaluation a sh:NodeShape ;
    rdfs:comment "What an identified body of evidence shows about one claim or requirement: whether it supports or challenges it, and whether it is enough to establish that. Stance and sufficiency are always relative to what the evidence is assessed against, and apply to the targeted evidence as a whole, not to each item in isolation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path schema1:url ],
        [ sh:description "Whether the evidence is enough to establish its stance: sufficient supporting evidence establishes the claim or requirement, and sufficient challenging evidence contradicts it. A sub-property of outcome." ;
            sh:in ( rfs:Sufficient rfs:Insufficient ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path rfs:evidenceSufficiency ],
        [ sh:datatype xsd:boolean ;
            sh:description "True when the issuer explicitly gives the judgment no limits beyond what it targets, so that an unlimited approval is a stated choice rather than an omission. Stated only on an evaluation without a scope: the two are exclusive." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path rfs:unbounded ],
        [ sh:datatype xsd:string ;
            sh:description "Why the issuer reached the outcome." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path rfs:rationale ],
        [ sh:description "Exact versions of claims or evaluations that a judgment depends on without judging them, for example the claim stating an enrolment cutoff that an approval relies on. Each value is the identifier of one immutable version. Specializes dcterms:references, so it asserts neither derivation nor support. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path rfs:reliesOn ],
        [ sh:description "Identifier of an exact version of a normative rule set applied, such as a credit class, a methodology or a program guide version. It is content and enters the identity of the record. It is distinct from a schema-version declaration, which states which schema the RDF conforms to. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path rfs:appliesRuleSet ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises: its ClaimIRI. A Claim has no identifier slot, because its ClaimIRI is computed over its canonical form outside Claim content (regen-network/claims#1), so the value is a bare IRI and the slot names no class. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its evaluations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path prov:wasRevisionOf ],
        [ sh:description "The Evidence records assessed, as one body of evidence. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rfs:hasTarget ],
        [ sh:class rfs:Entity ;
            sh:description "The issuer: the party that makes the judgment and takes responsibility for it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path rfs:assertedBy ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the issuer relied on." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path rfs:hasEvidence ],
        [ sh:class rfs:Scope ;
            sh:description "Where the judgment applies: the subjects it covers, what it explicitly excludes, and what it does not establish." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path rfs:scope ],
        [ sh:description "What an evidence evaluation's stance and sufficiency are relative to: the IRI of an exact claim version, or of an exact requirement version as appliesRequirement names it. The schema has no Requirement class (WP5-01), so neither validator checks what the IRI identifies." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rfs:assessedAgainst ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion, as the claimants state it in natural language. It is asserted content, not a presentational summary: changing it changes the Claim. A claim type may also formalize the assertion, or add detail to it, in structured fields; the statement and those fields are one assertion and must agree. When they disagree, neither overrides the other: the Claim is internally inconsistent and is corrected by a new version before its evidence is evaluated. Specializes schema:description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path rfs:claimStatement ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the issuer made the judgment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$" ],
        [ sh:datatype xsd:string ;
            sh:description "Language of claimStatement, as a BCP 47 tag with a 2- or 3-letter ISO 639 primary language subtag, such as en or cs. It says nothing about the language of the cited sources, which they record themselves, or about how a statement translated from a source was derived." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path schema1:inLanguage ;
            sh:pattern "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$" ],
        [ sh:description "Exact requirement versions an evaluation applies or judges, whether or not the claimant named them. Each identifier names one immutable requirement version within an exact rule-set version, such as a checklist version: the same short ID can name different requirements in different versions. The rule-set and requirement records themselves are defined by WP5-01 (claims#30). Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rfs:appliesRequirement ],
        [ sh:description "How the assertion or judgment was established, as structured data, so that a consumer can distinguish, for example, a lab-measured value from a self-attested one. One method per record: its party and date are those of the record that carries it (for an evaluation, its issuer and assertedAt), so a subject checked by two methods has two records, each with its own party and date. A value of OTHER must come with verificationMethodDescriptor." ;
            sh:in ( rfs:SelfAttested rfs:PeerOrCommunity rfs:LabMeasured rfs:SensorDerived rfs:ModelEstimated rfs:ThirdPartyAudited rfs:OtherVerificationMethod ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path rfs:verificationMethod ],
        [ sh:class rfs:ClaimSubject ;
            sh:description "What the judgment is about: a project, plot or other subject. It is stated even when it is also the subject of a targeted claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path rfs:hasSubject ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of a verification method that the VerificationMethodType enumeration does not cover; required when verificationMethod is OTHER. It must contain a non-whitespace character, so an empty descriptor cannot leave the method unspecified. It is the extension path: a method that recurs is added to the enumeration in a later schema version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path rfs:verificationMethodDescriptor ;
            sh:pattern "\\S" ],
        [ sh:datatype xsd:string ;
            sh:description "Optional human-readable title of the claim, for display. It is not the assertion, which is claimStatement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path schema1:name ],
        [ sh:class rfs:EvidenceCitation ;
            sh:description "Where inside cited sources the material the assertion relies on is: citations, each with one source listed in hasEvidence and the selectors that locate the material. A source cited as a whole needs no citation. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path rfs:hasEvidenceCitation ],
        [ sh:description "Whether the evidence supports or challenges what it is assessed against, or has no bearing on it. A sub-property of outcome." ;
            sh:in ( rfs:Supports rfs:Challenges rfs:NoBearing ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path rfs:evidentialStance ] ;
    sh:targetClass rfs:EvidenceEvaluation .

rfs:GenericClaim a sh:NodeShape ;
    rdfs:comment "A Claim with base content only, for an assertion that needs no claim-type schema, such as a self-attested stewardship claim. It adds nothing to Claim, and its generated shapes are closed, so impacts, quantities, activities and other domain content are rejected; they belong to a claim-type schema." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class rfs:Evidence ;
            sh:description "Sources the claimant presents as evidence for the assertion, each the IRI of an Evidence record for the exact version cited. The record is its own document, described once and never inlined. Where inside a source the cited material is goes in hasEvidenceCitation. Whether a source actually supports the assertion is judged separately, by evaluations. Specializes dcterms:references. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path rfs:hasEvidence ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises: its ClaimIRI. A Claim has no identifier slot, because its ClaimIRI is computed over its canonical form outside Claim content (regen-network/claims#1), so the value is a bare IRI and the slot names no class. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its evaluations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasRevisionOf ],
        [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion, as the claimants state it in natural language. It is asserted content, not a presentational summary: changing it changes the Claim. A claim type may also formalize the assertion, or add detail to it, in structured fields; the statement and those fields are one assertion and must agree. When they disagree, neither overrides the other: the Claim is internally inconsistent and is corrected by a new version before its evidence is evaluated. Specializes schema:description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:claimStatement ],
        [ sh:datatype xsd:string ;
            sh:description "Language of claimStatement, as a BCP 47 tag with a 2- or 3-letter ISO 639 primary language subtag, such as en or cs. It says nothing about the language of the cited sources, which they record themselves, or about how a statement translated from a source was derived." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:inLanguage ;
            sh:pattern "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$" ],
        [ sh:class rfs:Entity ;
            sh:description "The agent or agents that take responsibility for asserting this exact content: an individual, organization or community. Each listed claimant takes responsibility for the whole assertion. Taking that responsibility is distinct from writing, extracting, generating, transforming or submitting the content: a person, tool or service that only did that is not a claimant unless it takes responsibility for the assertion itself. A collective that asserts as one body is a single claimant of type COMMUNITY or ORGANIZATION; listing it does not make its members co-claimants. The capacity in which a claimant acts, such as project proponent or verifier, is a role in the context of the claim, not a kind of agent. Listing a claimant records who takes responsibility; it does not by itself establish that the claimant is authorized to assert on behalf of a project, community, program or other party. Specializes prov:wasAttributedTo, so under PROV each claimant is an agent associated with the activity that generated the Claim, which is the act of asserting. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path rfs:assertedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the claimants made this assertion. For an assertion they made in a source document, such as a project plan, and that was transcribed later, it is when they made it there, not when it was extracted, transcribed or submitted. It is never the time of an observation, or the time the Claim record was generated, submitted, published or ingested. The same content asserted at a different time is a different Claim. Written in UTC with whole seconds and the offset +00:00, for example 2026-05-02T07:30:00+00:00. No other offset is accepted, and neither is the Z suffix." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$" ],
        [ sh:datatype xsd:string ;
            sh:description "Optional human-readable title of the claim, for display. It is not the assertion, which is claimStatement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class rfs:EvidenceCitation ;
            sh:description "Where inside cited sources the material the assertion relies on is: citations, each with one source listed in hasEvidence and the selectors that locate the material. A source cited as a whole needs no citation. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:hasEvidenceCitation ],
        [ sh:class rfs:ClaimSubject ;
            sh:description "The one focal resource the claim is about, as a ClaimSubject node identified by its IRI: a place, plot, project, organization, community, indicator, dataset or another claim. It is not every participant the assertion mentions: in a claim relating several parties, the others appear in named roles defined by the claim-type schema, or the relationship or activity itself is the subject. Claims about the same subject share its IRI and can be joined. Specialized claim schemas narrow the range to a subclass of ClaimSubject. Not the claimant, and not necessarily the feature of interest of an observation inside the claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path rfs:hasSubject ] ;
    sh:targetClass rfs:GenericClaim .

rfs:GenericEvaluation a sh:NodeShape ;
    rdfs:comment "An Evaluation with base content only, for a judgment made under no program's review vocabulary, such as a community steward's review. Its verdict, if any, is the generic outcome, which only this class carries: every other kind states its verdict with its own sub-property of outcome, so it cannot state two verdicts. Its generated shapes are closed: a program's fields belong to that program's kind of evaluation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Identifier of an exact version of a normative rule set applied, such as a credit class, a methodology or a program guide version. It is content and enters the identity of the record. It is distinct from a schema-version declaration, which states which schema the RDF conforms to. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path rfs:appliesRuleSet ],
        [ sh:description "What an evaluation judges or answers: the identifier of an exact, immutable version of a claim, of another evaluation, or of a snapshot (a fixed set of claim versions), or, for an evidence evaluation, of the Evidence records it assesses. Never a logical identifier or label. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rfs:hasTarget ],
        [ sh:description "Exact versions of claims or evaluations that a judgment depends on without judging them, for example the claim stating an enrolment cutoff that an approval relies on. Each value is the identifier of one immutable version. Specializes dcterms:references, so it asserts neither derivation nor support. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rfs:reliesOn ],
        [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path schema1:url ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises: its ClaimIRI. A Claim has no identifier slot, because its ClaimIRI is computed over its canonical form outside Claim content (regen-network/claims#1), so the value is a bare IRI and the slot names no class. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its evaluations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path prov:wasRevisionOf ],
        [ sh:class rfs:Entity ;
            sh:description "The issuer: the party that makes the judgment and takes responsibility for it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path rfs:assertedBy ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion, as the claimants state it in natural language. It is asserted content, not a presentational summary: changing it changes the Claim. A claim type may also formalize the assertion, or add detail to it, in structured fields; the statement and those fields are one assertion and must agree. When they disagree, neither overrides the other: the Claim is internally inconsistent and is corrected by a new version before its evidence is evaluated. Specializes schema:description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path rfs:claimStatement ],
        [ sh:datatype xsd:boolean ;
            sh:description "True when the issuer explicitly gives the judgment no limits beyond what it targets, so that an unlimited approval is a stated choice rather than an omission. Stated only on an evaluation without a scope: the two are exclusive." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path rfs:unbounded ],
        [ sh:datatype xsd:string ;
            sh:description "Why the issuer reached the outcome." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rfs:rationale ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the issuer relied on." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path rfs:hasEvidence ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the issuer made the judgment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$" ],
        [ sh:description "The verdict of a GenericEvaluation, as a term from the vocabulary of the program or rule set the judgment is made under. A kind of evaluation with its own allowed values declares its verdict as a sub-property of outcome with an enumerated range, such as evidentialStance or a program's requirement outcome, and does not carry outcome itself: both validators check the value, the kind cannot state a second, conflicting verdict, and a query for outcome still finds every verdict." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rfs:outcome ],
        [ sh:datatype xsd:string ;
            sh:description "Language of claimStatement, as a BCP 47 tag with a 2- or 3-letter ISO 639 primary language subtag, such as en or cs. It says nothing about the language of the cited sources, which they record themselves, or about how a statement translated from a source was derived." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path schema1:inLanguage ;
            sh:pattern "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$" ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of a verification method that the VerificationMethodType enumeration does not cover; required when verificationMethod is OTHER. It must contain a non-whitespace character, so an empty descriptor cannot leave the method unspecified. It is the extension path: a method that recurs is added to the enumeration in a later schema version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path rfs:verificationMethodDescriptor ;
            sh:pattern "\\S" ],
        [ sh:datatype xsd:string ;
            sh:description "Optional human-readable title of the claim, for display. It is not the assertion, which is claimStatement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path schema1:name ],
        [ sh:description "Exact requirement versions an evaluation applies or judges, whether or not the claimant named them. Each identifier names one immutable requirement version within an exact rule-set version, such as a checklist version: the same short ID can name different requirements in different versions. The rule-set and requirement records themselves are defined by WP5-01 (claims#30). Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rfs:appliesRequirement ],
        [ sh:class rfs:ClaimSubject ;
            sh:description "What the judgment is about: a project, plot or other subject. It is stated even when it is also the subject of a targeted claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path rfs:hasSubject ],
        [ sh:description "How the assertion or judgment was established, as structured data, so that a consumer can distinguish, for example, a lab-measured value from a self-attested one. One method per record: its party and date are those of the record that carries it (for an evaluation, its issuer and assertedAt), so a subject checked by two methods has two records, each with its own party and date. A value of OTHER must come with verificationMethodDescriptor." ;
            sh:in ( rfs:SelfAttested rfs:PeerOrCommunity rfs:LabMeasured rfs:SensorDerived rfs:ModelEstimated rfs:ThirdPartyAudited rfs:OtherVerificationMethod ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path rfs:verificationMethod ],
        [ sh:class rfs:Scope ;
            sh:description "Where the judgment applies: the subjects it covers, what it explicitly excludes, and what it does not establish." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:scope ],
        [ sh:class rfs:EvidenceCitation ;
            sh:description "Where inside cited sources the material the assertion relies on is: citations, each with one source listed in hasEvidence and the selectors that locate the material. A source cited as a whole needs no citation. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path rfs:hasEvidenceCitation ] ;
    sh:targetClass rfs:GenericEvaluation .

rfs:ProjectInfo a sh:NodeShape ;
    rdfs:label "Project Info" ;
    rdfs:comment "Base class with common fields used to define project info." ;
    sh:closed true ;
    sh:ignoredProperties ( rfs:hasAdministrativeArea rfs:marketType rfs:ecologicalConnectivityIndex rfs:creditClassVersion rfs:iucnConservationStatus rfs:projectDuration rfs:socialCulturalIndex rfs:hasManagementAreas rfs:hasProjectVerifier rfs:hasEnvironmentalAuthority rdf:type ) ;
    sh:property [ sh:description "The types of activities being implemented in projects" ;
            sh:in ( rft:ResidueTillageManagement rft:BiocharProduction rft:ImprovedForestManagement rft:Agroforestry rft:PrescribedGrazing rft:RiparianForestBuffers rft:SoilAmendments rft:Conservation rft:Ecotourism rft:CoverCropping rft:TreePlanting rft:PhotocatalystApplication rft:EcosystemRestoration rft:IndustrialBiocharProduction rft:ArtisanalBiocharProduction rft:Biochar rft:EnhancedRockWeathering rft:CompostAmendments rft:KeystoneSpeciesConservation rft:UmbrellaSpeciesConservation rft:Silvopasture rft:ForestFarming rft:NonUrbanForestImprovement rft:UrbanForestImprovement rft:Afforestation rft:Reforestation ) ;
            sh:order 15 ;
            sh:path rfs:activity ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path schema1:url ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for monitoring the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path rfs:hasProjectMonitor ],
        [ sh:datatype xsd:string ;
            sh:description "The region associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path rfs:region ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "The bioregion associated with the project." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path rfs:bioregion ],
        [ sh:datatype xsd:string ;
            sh:description "The type of biome associated with the project." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path rfs:biomeType ],
        [ sh:class rfs:ReferenceId ;
            sh:description "External reference IDs associated with the project." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path rfs:hasReferenceId ],
        [ sh:description "The environment type of the project." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:order 9 ;
            sh:path rfs:environmentType ],
        [ sh:datatype xsd:string ;
            sh:description "The start date of the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:startDate ],
        [ sh:datatype xsd:string ;
            sh:description "The sub-watershed associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rfs:subWatershed ],
        [ sh:datatype xsd:string ;
            sh:description "The watershed associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path rfs:watershed ],
        [ sh:datatype xsd:string ;
            sh:description "The end date of the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:endDate ],
        [ sh:class rfs:Entity ;
            sh:description "The organization that is a partner for the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path rfs:hasProjectPartner ],
        [ sh:class rfs:Impact ;
            sh:description "Co-benefits are any secondary impacts that may result from adhering to the protocol and/or management practices associated with the credit class. They can be qualitative or quantitative." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path rfs:hasCoBenefits ],
        [ sh:class rfs:Entity ;
            sh:description "The organization that owns the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path rfs:hasProjectOwner ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for owning the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path rfs:hasProjectDeveloper ],
        [ sh:class qudt:QuantityValue ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:projectSize ],
        [ sh:class rfs:Link ;
            sh:description "A list of links associated with the project." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path rfs:hasLinks ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for operating the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path rfs:hasProjectOperator ],
        [ sh:class rfs:Methodology ;
            sh:description "The methodology that the project uses." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path rfs:usesMethodology ],
        [ sh:class geo:Feature ;
            sh:description "The location of the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path rfs:hasFeature ],
        [ sh:class rfs:Impact ;
            sh:description "The primary impact expected from adhering to the protocol and/or management practices associated with the credit class. Generally speaking the quantifiable components of this impact are associated with the credit type that the credit class exists under (e.g. Carbon, Biodiversity, etc)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path rfs:hasPrimaryImpact ] ;
    sh:targetClass rfs:ProjectInfo .

rfs:ProjectPost a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class rfs:File ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:references ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ] ;
    sh:targetClass rfs:ProjectPost .

rfs:RegistryFindingEvaluation a sh:NodeShape ;
    rdfs:comment "A finding raised in a Regen Registry review (a corrective action, clarification or forward action request, or a material issue raised by the Registry Agent), or a later assessment of it. Each record states the finding's state as of its date and carries the finding's label; the current state is derived from the latest record, not stored on any of them. A finding cites at least one piece of evidence." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion, as the claimants state it in natural language. It is asserted content, not a presentational summary: changing it changes the Claim. A claim type may also formalize the assertion, or add detail to it, in structured fields; the statement and those fields are one assertion and must agree. When they disagree, neither overrides the other: the Claim is internally inconsistent and is corrected by a new version before its evidence is evaluated. Specializes schema:description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path rfs:claimStatement ],
        [ sh:description "Whether the finding is open or closed as of this record's date. A sub-property of outcome." ;
            sh:in ( rfs:FindingOpen rfs:FindingClosed ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path rfs:findingState ],
        [ sh:description "What an evaluation judges or answers: the identifier of an exact, immutable version of a claim, of another evaluation, or of a snapshot (a fixed set of claim versions), or, for an evidence evaluation, of the Evidence records it assesses. Never a logical identifier or label. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rfs:hasTarget ],
        [ sh:datatype xsd:string ;
            sh:description "Why the issuer reached the outcome." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path rfs:rationale ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises: its ClaimIRI. A Claim has no identifier slot, because its ClaimIRI is computed over its canonical form outside Claim content (regen-network/claims#1), so the value is a bare IRI and the slot names no class. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its evaluations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path prov:wasRevisionOf ],
        [ sh:description "How the assertion or judgment was established, as structured data, so that a consumer can distinguish, for example, a lab-measured value from a self-attested one. One method per record: its party and date are those of the record that carries it (for an evaluation, its issuer and assertedAt), so a subject checked by two methods has two records, each with its own party and date. A value of OTHER must come with verificationMethodDescriptor." ;
            sh:in ( rfs:SelfAttested rfs:PeerOrCommunity rfs:LabMeasured rfs:SensorDerived rfs:ModelEstimated rfs:ThirdPartyAudited rfs:OtherVerificationMethod ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 10 ;
            sh:path rfs:verificationMethod ],
        [ sh:datatype xsd:boolean ;
            sh:description "True when the issuer explicitly gives the judgment no limits beyond what it targets, so that an unlimited approval is a stated choice rather than an omission. Stated only on an evaluation without a scope: the two are exclusive." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path rfs:unbounded ],
        [ sh:description "Identifier of an exact version of a normative rule set applied, such as a credit class, a methodology or a program guide version. It is content and enters the identity of the record. It is distinct from a schema-version declaration, which states which schema the RDF conforms to. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path rfs:appliesRuleSet ],
        [ sh:description "The kind of finding." ;
            sh:in ( rfs:CorrectiveActionRequest rfs:ClarificationRequest rfs:ForwardActionRequest rfs:RegistryIssue rfs:OtherFindingType ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path rfs:findingType ],
        [ sh:description "Exact versions of claims or evaluations that a judgment depends on without judging them, for example the claim stating an enrolment cutoff that an approval relies on. Each value is the identifier of one immutable version. Specializes dcterms:references, so it asserts neither derivation nor support. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path rfs:reliesOn ],
        [ sh:class rfs:Entity ;
            sh:description "The issuer: the party that makes the judgment and takes responsibility for it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path rfs:assertedBy ],
        [ sh:description "The capacity in which the issuer is recorded as acting for this judgment. This value does not by itself establish the issuer's authority to act in that capacity." ;
            sh:in ( rfs:RegistryAgent rfs:ValidationVerificationBody rfs:CreditClassAdmin rfs:OtherIssuerRole ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path rfs:issuerRole ],
        [ sh:description "Exact requirement versions an evaluation applies or judges, whether or not the claimant named them. Each identifier names one immutable requirement version within an exact rule-set version, such as a checklist version: the same short ID can name different requirements in different versions. The rule-set and requirement records themselves are defined by WP5-01 (claims#30). Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path rfs:appliesRequirement ],
        [ sh:class rfs:Condition ;
            sh:description "Obligations the judgment carries to a later milestone, such as follow-up actions due before verification. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path rfs:conditions ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of a verification method that the VerificationMethodType enumeration does not cover; required when verificationMethod is OTHER. It must contain a non-whitespace character, so an empty descriptor cannot leave the method unspecified. It is the extension path: a method that recurs is added to the enumeration in a later schema version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path rfs:verificationMethodDescriptor ;
            sh:pattern "\\S" ],
        [ sh:class rfs:Scope ;
            sh:description "Where the judgment applies: the subjects it covers, what it explicitly excludes, and what it does not establish." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path rfs:scope ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the issuer made the judgment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$" ],
        [ sh:datatype xsd:string ;
            sh:description "The issuer's own identifier for a finding, stable across review rounds, such as \"CL 07(1)\". It groups the dated records about one finding; it is not the identifier of any of them." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:findingLabel ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the issuer relied on." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path rfs:hasEvidence ],
        [ sh:datatype xsd:string ;
            sh:description "Optional human-readable title of the claim, for display. It is not the assertion, which is claimStatement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "Language of claimStatement, as a BCP 47 tag with a 2- or 3-letter ISO 639 primary language subtag, such as en or cs. It says nothing about the language of the cited sources, which they record themselves, or about how a statement translated from a source was derived." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path schema1:inLanguage ;
            sh:pattern "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$" ],
        [ sh:class rfs:ClaimSubject ;
            sh:description "What the judgment is about: a project, plot or other subject. It is stated even when it is also the subject of a targeted claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path rfs:hasSubject ],
        [ sh:class rfs:EvidenceCitation ;
            sh:description "Where inside cited sources the material the assertion relies on is: citations, each with one source listed in hasEvidence and the selectors that locate the material. A source cited as a whole needs no citation. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path rfs:hasEvidenceCitation ] ;
    sh:targetClass rfs:RegistryFindingEvaluation .

rfs:RegistryReportEvaluation a sh:NodeShape ;
    rdfs:comment "An independent verifier's rating of the project in its validation or verification report, with the ratings the Program Guide (sections 12.4 and 12.5) gives such a report. It is the verifier's rating, not the Registry's decision." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;

            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path rfs:hasFeature ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for operating the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 23 ;
            sh:path rfs:hasProjectOperator ],
        [ sh:class rfs:Link ;
            sh:description "A list of links associated with the project." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:hasLinks ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:name ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for owning the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path rfs:hasProjectDeveloper ],
        [ sh:class rfs:Impact ;
            sh:description "The primary impact expected from adhering to the protocol and/or management practices associated with the credit class. Generally speaking the quantifiable components of this impact are associated with the credit type that the credit class exists under (e.g. Carbon, Biodiversity, etc)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path rfs:hasPrimaryImpact ],
        [ sh:class rfs:Methodology ;
            sh:description "The methodology that the project uses." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 26 ;
            sh:path rfs:usesMethodology ] ;
    sh:targetClass rfs:C01ProjectInfo .

rfs:C02ProjectInfo a sh:NodeShape ;
    rdfs:label "C02 Project Info" ;
    rdfs:comment "Project info for City Forest Carbon Credit projects." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The type of market for the associated credits." ;
            sh:in ( rfs:ComplianceMarket rfs:VoluntaryMarket ) ;
            sh:order 2 ;
            sh:path rfs:marketType ],
        [ sh:description "The environment type of the project." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:order 12 ;
            sh:path rfs:environmentType ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:description ],

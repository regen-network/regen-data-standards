            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rfs:claimStatement ],
        [ sh:class rfs:Entity ;
            sh:description "The issuer: the party that makes the judgment and takes responsibility for it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path rfs:assertedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Why the issuer reached the outcome." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path rfs:rationale ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises: its ClaimIRI. A Claim has no identifier slot, because its ClaimIRI is computed over its canonical form outside Claim content (regen-network/claims#1), so the value is a bare IRI and the slot names no class. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its evaluations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path prov:wasRevisionOf ],
        [ sh:description "Exact versions of claims or evaluations that a judgment depends on without judging them, for example the claim stating an enrolment cutoff that an approval relies on. Each value is the identifier of one immutable version. Specializes dcterms:references, so it asserts neither derivation nor support. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rfs:reliesOn ],
        [ sh:datatype xsd:string ;
            sh:description "Language of claimStatement, as a BCP 47 tag with a 2- or 3-letter ISO 639 primary language subtag, such as en or cs. It says nothing about the language of the cited sources, which they record themselves, or about how a statement translated from a source was derived." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path schema1:inLanguage ;
            sh:pattern "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$" ],
        [ sh:description "The capacity in which the issuer is recorded as acting for this judgment. This value does not by itself establish the issuer's authority to act in that capacity." ;
            sh:in ( rfs:RegistryAgent rfs:ValidationVerificationBody rfs:CreditClassAdmin rfs:OtherIssuerRole ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path rfs:issuerRole ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of a verification method that the VerificationMethodType enumeration does not cover; required when verificationMethod is OTHER. It must contain a non-whitespace character, so an empty descriptor cannot leave the method unspecified. It is the extension path: a method that recurs is added to the enumeration in a later schema version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path rfs:verificationMethodDescriptor ;
            sh:pattern "\\S" ],
        [ sh:class rfs:Scope ;
            sh:description "Where the judgment applies: the subjects it covers, what it explicitly excludes, and what it does not establish." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path rfs:scope ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the issuer relied on." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path rfs:hasEvidence ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the issuer made the judgment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$" ],
        [ sh:description "How the assertion or judgment was established, as structured data, so that a consumer can distinguish, for example, a lab-measured value from a self-attested one. One method per record: its party and date are those of the record that carries it (for an evaluation, its issuer and assertedAt), so a subject checked by two methods has two records, each with its own party and date. A value of OTHER must come with verificationMethodDescriptor." ;
            sh:in ( rfs:SelfAttested rfs:PeerOrCommunity rfs:LabMeasured rfs:SensorDerived rfs:ModelEstimated rfs:ThirdPartyAudited rfs:OtherVerificationMethod ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 9 ;
            sh:path rfs:verificationMethod ],
        [ sh:class rfs:ClaimSubject ;
            sh:description "What the judgment is about: a project, plot or other subject. It is stated even when it is also the subject of a targeted claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path rfs:hasSubject ],
        [ sh:class rfs:Condition ;
            sh:description "Obligations the judgment carries to a later milestone, such as follow-up actions due before verification. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path rfs:conditions ],
        [ sh:datatype xsd:string ;
            sh:description "Optional human-readable title of the claim, for display. It is not the assertion, which is claimStatement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path schema1:name ],
        [ sh:class rfs:EvidenceCitation ;
            sh:description "Where inside cited sources the material the assertion relies on is: citations, each with one source listed in hasEvidence and the selectors that locate the material. A source cited as a whole needs no citation. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path rfs:hasEvidenceCitation ],
        [ sh:description "Whether the applied requirement applies to the subject." ;
            sh:in ( rfs:Applicable rfs:NotApplicable ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path rfs:applicability ],
        [ sh:description "The one exact requirement version judged. Exactly one, so that the applicability and outcome are unambiguously that requirement's." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path rfs:appliesRequirement ] ;
    sh:targetClass rfs:RegistryRequirementEvaluation .

rfs:RegistryReviewEvaluation a sh:NodeShape ;
    rdfs:comment "A judgment made in a Regen Registry review by the Registry Agent, an independent verifier (VVB) or the Credit Class Admin. Abstract: every review judgment is one of its kinds (a requirement, finding or report evaluation), and each kind requires its own verdict field. An evaluation records a judgment; it is neither the state of the review workflow nor the Registry's institutional decision, such as approving a project's registration, which it may inform." ;
    sh:closed false ;
    sh:ignoredProperties ( rfs:requirementOutcome rfs:findingState rfs:findingLabel rfs:applicability rfs:reportRating rfs:findingType rdf:type ) ;
    sh:property [ sh:description "What an evaluation judges or answers: the identifier of an exact, immutable version of a claim, of another evaluation, or of a snapshot (a fixed set of claim versions), or, for an evidence evaluation, of the Evidence records it assesses. Never a logical identifier or label. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rfs:hasTarget ],
        [ sh:description "Link to a page with more information about the claim. A pointer for readers, not evidence; cite evidence with hasEvidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:boolean ;
            sh:description "True when the issuer explicitly gives the judgment no limits beyond what it targets, so that an unlimited approval is a stated choice rather than an omission. Stated only on an evaluation without a scope: the two are exclusive." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path rfs:unbounded ],
        [ sh:class rfs:Entity ;
            sh:description "The issuer: the party that makes the judgment and takes responsibility for it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path rfs:assertedBy ],
        [ sh:description "How the assertion or judgment was established, as structured data, so that a consumer can distinguish, for example, a lab-measured value from a self-attested one. One method per record: its party and date are those of the record that carries it (for an evaluation, its issuer and assertedAt), so a subject checked by two methods has two records, each with its own party and date. A value of OTHER must come with verificationMethodDescriptor." ;
            sh:in ( rfs:SelfAttested rfs:PeerOrCommunity rfs:LabMeasured rfs:SensorDerived rfs:ModelEstimated rfs:ThirdPartyAudited rfs:OtherVerificationMethod ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path rfs:verificationMethod ],
        [ sh:datatype xsd:string ;
            sh:description "Why the issuer reached the outcome." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path rfs:rationale ],
        [ sh:description "Identifier of the exact, immutable earlier Claim version that this Claim revises: its ClaimIRI. A Claim has no identifier slot, because its ClaimIRI is computed over its canonical form outside Claim content (regen-network/claims#1), so the value is a bare IRI and the slot names no class. It never names a logical claim or version family. In PROV a revision implies that both versions are aspects of the same thing (alternateOf), so use it only for a revised version of the same assertion; a separate, later assertion, such as a follow-up observation, is a new Claim and is not a revision. The earlier version is unchanged, its evaluations do not carry over, and selecting a current version happens outside the Claim." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path prov:wasRevisionOf ],
        [ sh:description "Identifier of an exact version of a normative rule set applied, such as a credit class, a methodology or a program guide version. It is content and enters the identity of the record. It is distinct from a schema-version declaration, which states which schema the RDF conforms to. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rfs:appliesRuleSet ],
        [ sh:datatype xsd:string ;
            sh:description "The assertion, as the claimants state it in natural language. It is asserted content, not a presentational summary: changing it changes the Claim. A claim type may also formalize the assertion, or add detail to it, in structured fields; the statement and those fields are one assertion and must agree. When they disagree, neither overrides the other: the Claim is internally inconsistent and is corrected by a new version before its evidence is evaluated. Specializes schema:description." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path rfs:claimStatement ],
        [ sh:description "Exact requirement versions an evaluation applies or judges, whether or not the claimant named them. Each identifier names one immutable requirement version within an exact rule-set version, such as a checklist version: the same short ID can name different requirements in different versions. The rule-set and requirement records themselves are defined by WP5-01 (claims#30). Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path rfs:appliesRequirement ],
        [ sh:class rfs:Evidence ;
            sh:description "Sources the issuer relied on." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path rfs:hasEvidence ],
        [ sh:description "Exact versions of claims or evaluations that a judgment depends on without judging them, for example the claim stating an enrolment cutoff that an approval relies on. Each value is the identifier of one immutable version. Specializes dcterms:references, so it asserts neither derivation nor support. Unordered set." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rfs:reliesOn ],
        [ sh:description "The capacity in which the issuer is recorded as acting for this judgment. This value does not by itself establish the issuer's authority to act in that capacity." ;
            sh:in ( rfs:RegistryAgent rfs:ValidationVerificationBody rfs:CreditClassAdmin rfs:OtherIssuerRole ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path rfs:issuerRole ],
        [ sh:class rfs:ClaimSubject ;
            sh:description "What the judgment is about: a project, plot or other subject. It is stated even when it is also the subject of a targeted claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path rfs:hasSubject ],
        [ sh:class rfs:Condition ;
            sh:description "Obligations the judgment carries to a later milestone, such as follow-up actions due before verification. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path rfs:conditions ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the issuer made the judgment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path rfs:assertedAt ;
            sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\+00:00$" ],
        [ sh:datatype xsd:string ;
            sh:description "Optional human-readable title of the claim, for display. It is not the assertion, which is claimStatement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path schema1:name ],
        [ sh:class rfs:Scope ;
            sh:description "Where the judgment applies: the subjects it covers, what it explicitly excludes, and what it does not establish." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path rfs:scope ],
        [ sh:datatype xsd:string ;
            sh:description "Language of claimStatement, as a BCP 47 tag with a 2- or 3-letter ISO 639 primary language subtag, such as en or cs. It says nothing about the language of the cited sources, which they record themselves, or about how a statement translated from a source was derived." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path schema1:inLanguage ;
            sh:pattern "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$" ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of a verification method that the VerificationMethodType enumeration does not cover; required when verificationMethod is OTHER. It must contain a non-whitespace character, so an empty descriptor cannot leave the method unspecified. It is the extension path: a method that recurs is added to the enumeration in a later schema version." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path rfs:verificationMethodDescriptor ;
            sh:pattern "\\S" ],
        [ sh:class rfs:EvidenceCitation ;
            sh:description "Where inside cited sources the material the assertion relies on is: citations, each with one source listed in hasEvidence and the selectors that locate the material. A source cited as a whole needs no citation. Unordered set." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path rfs:hasEvidenceCitation ] ;
    sh:targetClass rfs:RegistryReviewEvaluation .

rfs:VersionedLink a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version number of the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:version ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:VersionedLink .

linkml:Any a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass linkml:Any .

rfs:Activity a sh:NodeShape ;
    rdfs:comment "Something that took place over a period, identified by an IRI so that every piece of evidence it generated names the same activity. Its period is given as dates; prov:startedAtTime and prov:endedAtTime would require timestamps." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:class rfs:Entity ;
            sh:description "Responsibility of an agent for an activity (PROV), for example the farm operator who carried out the field operations a record documents. Claim-type schemas that describe a domain activity, such as a restoration, name its operator the same way. Use it only on a class that represents an activity (its PROV domain is prov:Activity); such classes declare the ProvActivity mixin. It is not attribution of a Claim: the operator and the claimant may differ, and when they coincide both relations are still stated." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype xsd:date ;
            sh:description "First day of the period, included." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:startDate ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:description "IRI of the activity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path rfs:id ],
        [ sh:datatype xsd:date ;
            sh:description "Last day of the period, included." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:endDate ] ;
    sh:targetClass rfs:Activity .

rfs:Cohort a sh:NodeShape ;
    rdfs:comment "The sites of a project whose baseline soil sampling took place in the same year. Each cohort has its own crediting and permanence periods, and approvals can be scoped to cohorts." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "IRI or CURIE of the subject, for example https://example.org/plot/A." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rfs:id ],
        [ sh:description "Identifier of the project this subject belongs to." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rfs:project ],
        [ sh:datatype xsd:integer ;
            sh:description "Year of the cohort's baseline soil sampling." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:baselineYear ] ;
    sh:targetClass rfs:Cohort .

rfs:ContentDigest a sh:NodeShape ;
    rdfs:comment "A cryptographic hash of the bytes of the cited source version: the whole file, not a passage a citation selects. A reader recomputes it over the bytes the resolver returns to check that they are the bytes cited." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( rfs:SHA256 rfs:BLAKE2b256 ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path rfs:algorithm ],
        [ sh:datatype xsd:string ;
            sh:description "Lowercase hexadecimal digest." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:digestValue ;
            sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:targetClass rfs:ContentDigest .

rfs:DeviationRequest a sh:NodeShape ;
    rdfs:comment "A project-specific deviation from a requirement that the project developer requests. Whether it is approved is a separate evaluation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Why the deviation is requested, including why it is as conservative as the requirement it replaces." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rfs:justification ],
        [ sh:description "Exact requirement versions the claimant presents a Claim, or part of it, as responding to, identified as for appliesRequirement. It records the claimant's intent only: it implies neither that the requirement applies nor that it is met, conformed to or accepted, which an evaluation judges with appliesRequirement. Not on the base Claim: a claim type selects it where it needs it. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rfs:addressesRequirement ],
        [ sh:datatype xsd:string ;
            sh:description "What the deviation replaces, and with what." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:replacedParameters ] ;
    sh:targetClass rfs:DeviationRequest .

rfs:File a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:creator ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:iri ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:class geo:Geometry ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path geo:hasGeometry ] ;
    sh:targetClass rfs:File .

rfs:ManagementArea a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "the activity" ;
            sh:in ( rft:ResidueTillageManagement rft:BiocharProduction rft:ImprovedForestManagement rft:Agroforestry rft:PrescribedGrazing rft:RiparianForestBuffers rft:SoilAmendments rft:Conservation rft:Ecotourism rft:CoverCropping rft:TreePlanting rft:PhotocatalystApplication rft:EcosystemRestoration rft:IndustrialBiocharProduction rft:ArtisanalBiocharProduction rft:Biochar rft:EnhancedRockWeathering rft:CompostAmendments rft:KeystoneSpeciesConservation rft:UmbrellaSpeciesConservation rft:Silvopasture rft:ForestFarming rft:NonUrbanForestImprovement rft:UrbanForestImprovement rft:Afforestation rft:Reforestation ) ;
            sh:order 0 ;
            sh:path rfs:projectActivity ],
        [ sh:class qudt:QuantityValue ;
            sh:description "the extent" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dcterms:extent ] ;
    sh:targetClass rfs:ManagementArea .

rfs:MethodologyUse a sh:NodeShape ;
    rdfs:comment "A methodology version the project applies, and for what." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Identifier of an exact methodology version." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rfs:methodology ],
        [ sh:datatype xsd:string ;
            sh:description "What the methodology is used for in this project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rfs:methodologyScope ],
        [ sh:description "Whether the methodology is the project's primary quantification methodology or a supplementary one, used for part of the assessment such as the baseline or leakage." ;
            sh:in ( rfs:PrimaryMethodology rfs:SupplementaryMethodology ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path rfs:methodologyRole ] ;
    sh:targetClass rfs:MethodologyUse .

rfs:Plot a sh:NodeShape ;
    rdfs:comment "One land parcel of a site. The plots of a site are the plots whose site is that site." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Identifier of the parcel in the national land parcel register, for example LPIS in Czechia or GSAA in Slovakia." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:parcelId ],
        [ sh:description "IRI or CURIE of the subject, for example https://example.org/plot/A." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rfs:id ],
        [ sh:datatype xsd:string ;
            sh:description "The key that identifies the plot in the project's records." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:plotKey ],
        [ sh:description "Identifier of the plot's site." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rfs:site ] ;
    sh:targetClass rfs:Plot .

rfs:Project a sh:NodeShape ;
    rdfs:comment "An aggregate project of enrolled sites." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The project's identifier in the registry, once assigned." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:registryProjectId ],
        [ sh:description "IRI or CURIE of the subject, for example https://example.org/plot/A." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rfs:id ] ;
    sh:targetClass rfs:Project .

rfs:Site a sh:NodeShape ;
    rdfs:comment "One enrolled site (farm) of an aggregate project." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Identifier of the project this subject belongs to." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rfs:project ],
        [ sh:description "IRI or CURIE of the subject, for example https://example.org/plot/A." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path rfs:id ],
        [ sh:datatype xsd:string ;
            sh:description "ISO 3166-1 alpha-2 country code." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:addressCountry ;
            sh:pattern "^[A-Z]{2}$" ],
        [ sh:description "Identifier of the site's cohort." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rfs:cohort ],
        [ sh:datatype xsd:string ;
            sh:description "The key that identifies the site in the project's records." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:siteKey ] ;
    sh:targetClass rfs:Site .

rfs:BufferPoolAccount a sh:NodeShape ;
    rdfs:comment "Details of the buffer pool account associated with a credit class." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The allocation of the buffer pool." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rfs:poolAllocation ;
            sh:pattern "^\\d+(\\.\\d+)?%$" ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "The wallet address of the buffer pool account." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:walletAddress ;
            sh:pattern "^regen1[0-9a-zA-Z]+$" ] ;
    sh:targetClass rfs:BufferPoolAccount .

rfs:CreditProtocol a sh:NodeShape ;
    rdfs:comment "Details of the credit protocol that defines the requirements and process to register and issue credits under a credit protocol. Credit Protocols can be registered under a program or independent. It could include specific methods to measure and monitor, or reference other methodology documents." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version number of the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:version ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:CreditProtocol .

rfs:CreditingProgram a sh:NodeShape ;
    rdfs:comment "Details of the program that oversees the crediting protocol associated with this credit class." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version number of the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:version ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:CreditingProgram .

rfs:Registry a sh:NodeShape ;
    rdfs:comment "Details of the registry where the credits are tracked." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:Registry .

geo:Geometry a sh:NodeShape ;
    rdfs:comment "A geometry defined using Well-Known Text (WKT), compliant with GeoSPARQL 1.1." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A WKT literal with an optional CRS prefix (e.g., '<http://www.opengis.net/def/crs/EPSG/0/4326> POINT(...)')." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path geo:asWKT ] ;
    sh:targetClass geo:Geometry .

<http://www.w3.org/ns/oa#FragmentSelector> a sh:NodeShape ;
    rdfs:comment "Locates a segment with a fragment identifier, such as page=16, in the syntax conformsTo names, for example RFC 3778 for PDF pages." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The specification of the fragment syntax, for example http://tools.ietf.org/rfc/rfc3778 for PDF or http://www.w3.org/TR/media-frags/ for audio and video." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dcterms:conformsTo ],
        [ sh:description "A selector applied to the segment this one selects, for example a quotation within a page. Several are alternatives with the same result. Unordered set." ;
            sh:or ( [ sh:class <http://www.w3.org/ns/oa#FragmentSelector> ] [ sh:class <http://www.w3.org/ns/oa#TextQuoteSelector> ] ) ;
            sh:order 3 ;
            sh:path <http://www.w3.org/ns/oa#refinedBy> ],
        [ sh:description "The kind of selector, as a CURIE: oa:FragmentSelector or oa:TextQuoteSelector." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rdf:type ],
        [ sh:datatype xsd:string ;
            sh:description "The fragment identifier, without the leading \"#\", such as page=16." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdf:value ] ;
    sh:targetClass <http://www.w3.org/ns/oa#FragmentSelector> .

<http://www.w3.org/ns/oa#TextQuoteSelector> a sh:NodeShape ;
    rdfs:comment "Locates a passage by quoting it exactly, with the text just before and after it to tell repeated passages apart. Used only when the quotation itself locates the passage; a display excerpt, translation or paraphrase is not a selector." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A selector applied to the segment this one selects, for example a quotation within a page. Several are alternatives with the same result. Unordered set." ;
            sh:or ( [ sh:class <http://www.w3.org/ns/oa#FragmentSelector> ] [ sh:class <http://www.w3.org/ns/oa#TextQuoteSelector> ] ) ;
            sh:order 4 ;
            sh:path <http://www.w3.org/ns/oa#refinedBy> ],
        [ sh:datatype xsd:string ;
            sh:description "Text immediately after the passage." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://www.w3.org/ns/oa#suffix> ],
        [ sh:datatype xsd:string ;
            sh:description "Text immediately before the passage." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <http://www.w3.org/ns/oa#prefix> ],
        [ sh:datatype xsd:string ;
            sh:description "The exact text of the passage." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <http://www.w3.org/ns/oa#exact> ],
        [ sh:description "The kind of selector, as a CURIE: oa:FragmentSelector or oa:TextQuoteSelector." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path rdf:type ] ;
    sh:targetClass <http://www.w3.org/ns/oa#TextQuoteSelector> .

rfs:Condition a sh:NodeShape ;
    rdfs:comment "An obligation a judgment carries to a later milestone, such as a follow-up action due before verification or a design condition binding on future verifications." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "When the condition must be met." ;
            sh:in ( rfs:RegistrationMilestone rfs:PreIssuanceMilestone rfs:VerificationMilestone rfs:FutureVerificationsMilestone ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path rfs:milestone ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "The issuer's label for the condition, such as \"RA-6\"." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:conditionLabel ] ;
    sh:targetClass rfs:Condition .

geo:Feature a sh:NodeShape ;
    rdfs:comment "A spatial feature, such as a project or area, with a defined geometry and optional bounding box." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class geo:Geometry ;
            sh:description "A derived geometry representing the bounding box of the geometry or feature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path geo:hasBoundingBox ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class geo:Geometry ;
            sh:description "A derived geometry representing the centroid of the feature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path geo:hasCentroid ],
        [ sh:class geo:Geometry ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path geo:hasGeometry ] ;
    sh:targetClass geo:Feature .

rfs:DatePeriod a sh:NodeShape ;
    rdfs:comment "A period between two dates, both included." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "Last day of the period, included." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:endDate ],
        [ sh:datatype xsd:date ;
            sh:description "First day of the period, included." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:startDate ] ;
    sh:targetClass rfs:DatePeriod .

rfs:Link a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( schema1:version rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:description ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:Link .

rfs:ReferenceId a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "An optional label that describes the identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:referenceType ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier value" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rfs:identifier ] ;
    sh:targetClass rfs:ReferenceId .

qudt:QuantityValue a sh:NodeShape ;
    rdfs:comment "A value that represents a quantity, with a numeric value and the unit it is expressed in, as a QUDT quantity value." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "IRI of the unit in the QUDT unit vocabulary (http://qudt.org/vocab/unit/), for example unit:HA (hectare)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path qudt:hasUnit ],
        [ sh:datatype xsd:float ;
            sh:description "The numeric value of the quantity. It cannot be negative: the quantities stated so far are sizes and areas." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path qudt:value ] ;
    sh:targetClass qudt:QuantityValue .

rfs:Methodology a sh:NodeShape ;
    rdfs:comment "Details about a specific methodology." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version number of the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path schema1:version ],
        [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the resource / entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass rfs:Methodology .

rfs:Scope a sh:NodeShape ;
    rdfs:comment "Where an evaluation applies, as structured fields, so that a consumer can check whether a subject falls inside it. A scope always names the subjects it covers. An evaluation without a scope applies only to what it targets, unless it states unbounded." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "What the judgment is not, for example that an approval of a project structure is not a validation of its evidence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rfs:limitation ],
        [ sh:description "Identifiers of the subjects the judgment covers, for example the enrolment cohorts an approval is limited to. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rfs:appliesTo ],
        [ sh:datatype xsd:string ;
            sh:description "What the judgment explicitly does not cover. Unordered set." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rfs:exclusion ] ;
    sh:targetClass rfs:Scope .

rfs:ClaimSubject a sh:NodeShape ;
    rdfs:comment "What a Claim is about: a place, plot, project, organization, community, indicator, dataset or another claim, identified by an IRI so that claims about the same subject can be joined. In a Claim the node carries only the subject's IRI and its type, the class a claim type's hasSubject range names, so that the range can be checked in one document. Its name and full description live on its own resource, not in each Claim about it: otherwise every Claim would state its own name for the subject, and the names would merge on the subject's IRI." ;
    sh:closed true ;
    sh:ignoredProperties ( rfs:plotKey rfs:siteKey rfs:project rfs:registryProjectId rfs:parcelId rfs:site rfs:baselineYear rfs:cohort rdf:type schema1:addressCountry ) ;
    sh:property [ sh:description "IRI or CURIE of the subject, for example https://example.org/plot/A." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path rfs:id ] ;
    sh:targetClass rfs:ClaimSubject .

rfs:EvidenceCitation a sh:NodeShape ;
    rdfs:comment "Where inside one cited source the material a claim relies on is: a local profile of a Web Annotation resource selection, with exactly one source and zero or more selectors. Without a selector the whole source is cited. Several selectors are alternative ways to locate the same passage; distinct passages of one source are separate citations. Changing a selector changes the citation, and so the citing record's content, but never the source's IRI or hash." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "How to locate the cited segment of the source. Several selectors are alternatives that locate the same segment. Unordered set." ;
            sh:or ( [ sh:class <http://www.w3.org/ns/oa#FragmentSelector> ] [ sh:class <http://www.w3.org/ns/oa#TextQuoteSelector> ] ) ;
            sh:order 1 ;
            sh:path <http://www.w3.org/ns/oa#hasSelector> ],
        [ sh:class rfs:Evidence ;
            sh:description "The cited source: the IRI of an Evidence record, which the citing record also lists in hasEvidence." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path <http://www.w3.org/ns/oa#hasSource> ] ;
    sh:targetClass rfs:EvidenceCitation .

rfs:Impact a sh:NodeShape ;
    rdfs:comment "Represents an ecological, social, or broader impact or benefit usually in the context of a project's activities. Impacts can be measurable or qualitative." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name is optional and will be inferred from the ImpactType if not provided." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:description "Type of impact, such as ecological, social, or economic." ;
            sh:in ( rft:ReducedFertilizerAmendments rft:AvoidedDeforestationDegradation rft:ImprovedCulturalHeritageAwareness rft:ImprovedBiodiversity rft:ImprovedEnvironmentalEducationOutreach rft:ReducedSoilErosion rft:ReducedHerbicideAmendments rft:ImprovedForestHealth rft:ImprovedCommunityHealth rft:ImprovedWildlifeHabitat rft:ImprovedSoilHealth rft:IncreasedForestCover rft:ReducedPesticideAmendments rft:ImprovedWaterInfiltration rft:ImprovedWaterHoldingCapacity rft:IncreasedCarbonSequestrationStorage rft:ReducedIrrigation rft:ImprovedSoilStructure rft:ImprovedNutrientCycling rfs:UnknownImpact ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path rfs:hasImpactType ],
        [ sh:description "List of relevant Sustainable Development Goals that this impact supports." ;
            sh:in ( sdgs:goal1 sdgs:goal2 sdgs:goal3 sdgs:goal4 sdgs:goal5 sdgs:goal6 sdgs:goal7 sdgs:goal8 sdgs:goal9 sdgs:goal10 sdgs:goal11 sdgs:goal12 sdgs:goal13 sdgs:goal14 sdgs:goal15 sdgs:goal16 sdgs:goal17 ) ;
            sh:order 2 ;
            sh:path rfs:supportsSDG ] ;
    sh:targetClass rfs:Impact .

rfs:Evidence a sh:NodeShape ;
    rdfs:comment "A source cited as evidence: a document, dataset, record or observation, identified by the IRI of the exact version cited. The IRI identifies the whole source, never a position inside it: positions are on the citation, so the same source cited at several places stays one resource with one hash. A record is its own document, which claims and evaluations reference by IRI. Whether it actually supports a claim is judged separately, by evaluations, and its current availability or access is not recorded here." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Genre of the cited source, from the DCMI Type Vocabulary, which the dcterms:type definition recommends. Finer kinds of evidence that a program accepts, such as a lease agreement, belong to that program's rule set, not to Evidence." ;
            sh:in ( dcmitype:Collection dcmitype:Dataset dcmitype:Event dcmitype:Image dcmitype:InteractiveResource dcmitype:MovingImage dcmitype:PhysicalObject dcmitype:Service dcmitype:Software dcmitype:Sound dcmitype:StillImage dcmitype:Text ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path dcterms:type ],
        [ sh:description "IRI or CURIE of the exact source version cited, without a fragment, for example https://example.org/project-plan-v2.pdf. A position inside the source, such as a page, is a selector on the citation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rfs:id ;
            sh:pattern "^[^#]*$" ],
        [ sh:description "IRI of the licence document or versioned licence terms in effect for this version of the source. When absent, the terms must be read as \"unspecified — all rights reserved\" (rfs:UnspecifiedAllRightsReserved), never as unrestricted." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dcterms:license ],
        [ sh:datatype xsd:string ;
            sh:description "What the source is. The record is shared by every claim that cites the source, so it describes the source itself, not one citer's use of it; where a claim relies on it goes on the citation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:description "Where the bytes of the cited version can be fetched. The data can stay where its owner keeps it; the claim stores only the hash and the resolver. Unordered set." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path rfs:resolver ],
        [ sh:datatype xsd:string ;
            sh:description "Media type of the source, for example application/pdf." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:format ],
        [ sh:class rfs:Activity ;
            sh:description "The activity that produced the cited source, with its period and who carried it out: for example the soil sampling behind a results file, or the field operations a farm management record documents. When the evidence was produced is the activity's period, not a field of Evidence, because PROV-O declares activities and entities disjoint. Evidence produced by the same activity names the same activity IRI." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Title of the cited source." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:date ;
            sh:description "Date of the cited version of the source." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:issued ],
        [ sh:datatype xsd:string ;
            sh:description "Language of the source's text, as a BCP 47 tag with a 2- or 3-letter ISO 639 primary language subtag, such as cs. It is recorded separately from the language of the claims that cite the source, which may be written in another language; it says nothing about how a claim's statement was derived from the source." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:inLanguage ;
            sh:pattern "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$" ],
        [ sh:class rfs:ContentDigest ;
            sh:description "Hash of the bytes of the cited source version. This is the hash of the source, which a citation needs; it is not the hash of the Claim or Evaluation that cites it, which is never part of its own content." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path rfs:contentHash ] ;
    sh:targetClass rfs:Evidence .

rfs:Entity a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Link to a valid URL where more information can be found about the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path schema1:url ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the entity / resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:in ( rfs:Individual rfs:Organization rfs:Community ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path rfs:type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:image ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "On-chain wallet address (bech32 or hex) bridging semantic identity to signing capability. Used by the identity bridge to link KOI entity URIs to on-chain accounts for CLAMS and EAS interop." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path rfs:walletAddress ] ;
    sh:targetClass rfs:Entity .


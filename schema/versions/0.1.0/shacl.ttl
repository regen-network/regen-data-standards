        [ sh:description "The verifier's rating in its report. A sub-property of outcome." ;
            sh:in ( rfs:Acceptance rfs:AcceptanceWithContingencies rfs:Rejection ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;

        [ sh:datatype xsd:string ;
            sh:description "The type of biome associated with the project." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path rfs:biomeType ],
        [ sh:class rfs:ReferenceId ;
            sh:description "External reference IDs associated with the project." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path rfs:hasReferenceId ],
        [ sh:description "The environment type of the project." ;
            sh:in ( rft:Marine rft:Cropland rft:UrbanTrees rft:Shrubland rft:Pasture rft:Savanna rft:Grassland rft:AgroforestrySystem rft:PermanentIce rft:Wetland rft:Freshwater rft:Orchard rft:AquacultureSystem rft:Vineyard rft:Desert rft:Forest rft:IrrigatedCropland rft:RainfedCropland rft:TemperateShrubland rft:BorealShrubland rft:TropicalShrubland rft:Marsh rft:Bog rft:Swamp rft:TropicalForest rft:TemperateForest rft:BorealForest rft:Coastal rft:DeepWater rft:CoralReef rft:TemperateGrassland rft:Tundra rft:TropicalGrassland rft:Lake rft:Watercourse ) ;
            sh:order 9 ;
            sh:path rfs:environmentType ],
        [ sh:datatype xsd:string ;
            sh:description "The start date of the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path schema1:startDate ],
        [ sh:datatype xsd:string ;
            sh:description "The sub-watershed associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path rfs:subWatershed ],
        [ sh:datatype xsd:string ;
            sh:description "The watershed associated with the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path rfs:watershed ],
        [ sh:datatype xsd:string ;
            sh:description "The end date of the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path schema1:endDate ],
        [ sh:class rfs:Entity ;
            sh:description "The organization that is a partner for the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path rfs:hasProjectPartner ],
        [ sh:class rfs:Impact ;
            sh:description "Co-benefits are any secondary impacts that may result from adhering to the protocol and/or management practices associated with the credit class. They can be qualitative or quantitative." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path rfs:hasCoBenefits ],
        [ sh:class rfs:Entity ;
            sh:description "The organization that owns the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path rfs:hasProjectOwner ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the entity / resource." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:class rfs:Entity ;
            sh:description "The organization responsible for owning the project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path rfs:hasProjectDeveloper ],
        [ sh:class qudt:QuantityValue ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path rfs:projectSize ],
        [ sh:class rfs:Link ;
